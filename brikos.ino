// Drum machine — ST7735 sequencer + rotary encoder edit, NeoPixel 5x5 reactive
// lights, and real-time synthesized drum voices out the MAX98357A over I2S.
//
// Genesis One — 8 ports
// P1=Encoder1(grid)  P2=ST7735  P3=Touchpad(drum)  P4=TactileLEDButton(snare)  P5=Encoder2(drum/BPM)  P6=Pot(vol)  P7=TwoPad(jam)  P8=Amp
//
// Audio is generated sample-by-sample (kick / snare / hihat synthesis) and pushed
// to the amp's I2S pins. The sequencer clock is sample-accurate, and both the LED
// matrix and the display read the live drum envelopes, so sound and light fire
// together on every step.

#include <SPI.h>
#include <Adafruit_GFX.h>
#include <Fonts/FreeSansBold9pt7b.h>
#include <Adafruit_ST7735.h>
#include <Adafruit_NeoPixel.h>
#include <RotaryEncoder.h>
#include <Preferences.h>
#include "driver/i2s.h"
#include <math.h>

// ---- Encoder 1 (P1) — grid navigation / step edit ----
#define ENC_BTN P1_IO0
#define ENC_CLK P1_IO1
#define ENC_DT  P1_IO2

// ---- Display (P2) ----
#define TFT_CS  P2_IO0
#define TFT_RST P2_IO1
#define TFT_DC  P2_IO2

// ---- Touchpad TTP223 (P3) — live drum trigger pad ----
#define TOUCH_PIN  P3_IO1

// ---- Tactile LED Button (P4): second live drum trigger ----
#define DRUM_BUTTON P4_IO1
#define DRUM_LED P4_IO2

// ---- Encoder 2 (P5) — drum select (rotate) + tap tempo (press) ----
#define ENC2_BTN P5_IO0
#define ENC2_CLK P5_IO1
#define ENC2_DT  P5_IO2

// ---- Potentiometer (P6) — master volume ----
#define POT_PIN    P6_IO0

// ---- Two Pad (P7) — jam synth ----
#define PAD_BTN1   P7_IO1
#define PAD_BTN2   P7_IO2

// ---- Amp I2S (P8) — P8_IO1/IO2 are UART0 pins; i2s_set_pin() reconfigures via GPIO matrix ----
#define I2S_DOUT P8_IO0
#define I2S_BCLK P8_IO1
#define I2S_LRC  P8_IO2

#define SR         44100
#define BLOCK      128
#define STEPS      8
#define TRACKS     7
#define MASTER_VOL 0.85f

// ---- Per-track FX ----
#define FXCOUNT    11      // OFF DELAY REVERB PHASER FLANGE CHORUS DRIVE CRUSH TREMOLO RINGMOD STUTTER
#define FXBUF      4096    // per-track effect buffer (int16), ~93ms at 44.1k
#define DELAY_LEN  3000    // delay echo tap (~68ms)
#define FLANGE_CTR 220.0f  // flanger center delay (samples)
#define FLANGE_DEP 180.0f  // flanger sweep depth (samples)
#define CHORUS_CTR 700.0f  // chorus center delay (~16ms)
#define CHORUS_DEP 320.0f  // chorus sweep depth (samples)
#define RV_C1      1557    // reverb comb 1 length (samples)
#define RV_C2      1617    // reverb comb 2 length
#define RV_AP      225     // reverb diffusion allpass length

// ---- Global glitch FX (whole-mix, one at a time, set in MODE_GLITCH) ----
#define GFXCOUNT   16      // OFF CRUSH DECIMATE GATE REPEAT REVERSE FILTER WOBBLE RINGMOD ROBOT TAPESTOP VINYL STUTTER FREEZE STAMMER WARP
#define GFXBUF     8192    // global effect buffer (int16), ~186ms at 44.1k

SPIClass mySPI(FSPI);
Adafruit_ST7735 tft = Adafruit_ST7735(&mySPI, TFT_CS, TFT_DC, TFT_RST);
GFXcanvas16 canvas(160, 80);
Adafruit_NeoPixel onboardPixel(1, 21, NEO_GRB + NEO_KHZ800);  // onboard status pixel — keep it dark
RotaryEncoder encoder(ENC_CLK, ENC_DT, RotaryEncoder::LatchMode::TWO03);
RotaryEncoder encoder2(ENC2_CLK, ENC2_DT, RotaryEncoder::LatchMode::TWO03);

