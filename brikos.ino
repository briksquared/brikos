const char* soundName(int track, int v) {
  switch (track) {
    case 0: { const char* n[] = { "808", "PUNCH", "SUB", "TIGHT", "CLICK" };   return n[v]; }
    case 1: { const char* n[] = { "NOISE", "RIM", "FAT", "SNAP", "TIGHT" };    return n[v]; }
    case 2: { const char* n[] = { "CLOSED", "OPEN", "PEDAL", "RIDE"   };       return n[v]; }
    case 3: { const char* n[] = { "CLAP", "SHAKER", "TAMB", "SNAP" };          return n[v]; }
    case 4: { const char* n[] = { "LOW", "MID", "HIGH", "FLOOR" };             return n[v]; }
    default: return synthDefs[v].name;
  }
}

// Category labels follow the actual stable-ID blocks; DSP recipes stay unchanged.
const char* synthCat(int v) {
  const char* n[] = { "ANALOG", "VINTAGE", "TEXTURE", "MODERN", "FM", "WEST", "KEYS", "STRINGS", "LEADS" };
  int c = v < 120 ? v / 20 : (v < 138 ? 6 : (v < 158 ? 7 : 8));
  if (c < 0) c = 0; if (c > 8) c = 8;
  return n[c];
}

const char* fxName(int f) {
  const char* n[] = { "OFF", "DELAY", "REVERB", "PHASER", "FLANGE", "CHORUS",
                      "DRIVE", "CRUSH", "TREMOLO", "RINGMOD", "STUTTER" };
  return n[f];
}

// 20 matrix animation styles, chosen live in MODE_LED (rotate to preview)
const char* ledName(int s) {
  const char* n[] = { "PAINT", "BARS", "SPARKLE", "RINGS", "CHASE", "RAIN",
                      "PULSE", "HSCAN", "VSCAN", "IMPLODE", "CHECKER", "FLICKER",
                      "WAVE", "SPIRAL", "DIAG", "CORNERS", "STROBE", "RIPPLE",
                      "FILL", "TWINKLE" };
  return n[s];
}

// ---- Preset sequences — a full pattern + per-track sounds + tempo, loaded live
// in MODE_PRESET (rotate to browse, short-press to load). Rows: K S H C T B.
struct SongSlot { uint16_t preset; uint8_t repeats; };
struct Preset {
  const char* name;
  int bpm;
  uint8_t pat[TRACKS][STEPS];
  uint8_t snd[TRACKS];
  uint8_t trackFX[TRACKS];
  uint8_t reverbSend[TRACKS];
  uint8_t gTrack[TRACKS];
  uint8_t compThr;
  uint8_t globalFX;
  int8_t transposeAmt;
  uint8_t glideAmt;
  uint8_t swing;
  uint16_t chain[8];
  SongSlot song[16];
  float masterVerbAmt = 1.0f;
};
