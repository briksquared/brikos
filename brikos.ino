static const float TWO_PI_F = 6.2831853f;

// ---- fast transcendentals for the audio path — a sine lookup table + a Pade
// tanh, replacing the per-sample sinf()/tanhf() (softly emulated on the S3 FPU,
// hundreds of cycles each) so block-generation time stays well under budget.
// The table is filled once in setup(), before the audio task starts.
#define SIN_TBL 1024
float sinTbl[SIN_TBL + 1];
inline float fastSinP(float ph) {        // sine of a phase in turns (0..1)
  ph -= (int)ph; if (ph < 0) ph += 1.0f;
  float f = ph * SIN_TBL; int i = (int)f; float fr = f - i;
  return sinTbl[i] + (sinTbl[i + 1] - sinTbl[i]) * fr;
}
inline float fastSin(float rad) { return fastSinP(rad * (1.0f / TWO_PI_F)); }
// Same Pade saturation curve, interpolated instead of dividing per sample.
// Initialized before audio starts; 4 KB internal RAM, no allocation in DSP.
float saturationTable[1025];
inline float fastTanh(float x) {
  float a = fabsf(x);
  if (a >= 3.0f) return x < 0 ? -1.0f : 1.0f;
  float p = a * (1024.0f / 3.0f);
  int i = (int)p;
  float y = saturationTable[i] + (saturationTable[i+1]-saturationTable[i]) * (p-i);
  return x < 0 ? -y : y;
}
// Fixed envelope coefficients belong to startup, not function-local guarded
// static initialization checked 44,100 times per second.
float d003, d0025, d004, d055, d22, d0012, d070, d014;

// PolyBLEP — band-limits the hard edges of the saw/square/pulse oscillators so
// their harmonics above Nyquist don't fold back as inharmonic aliasing (the
// harsh, cheap "digital toy" edge a naive ramp/step has). Corrects each
// discontinuity with a 2-sample polynomial residual; dt is the phase increment.
inline float polyBlep(float t, float dt) {
  if (t < dt)        { t /= dt;             return t + t - t * t - 1.0f; }
  if (t > 1.0f - dt) { t = (t - 1.0f) / dt; return t * t + t + t + 1.0f; }
  return 0.0f;
}

