void setBPM(int b) {
  bpm = b < 40 ? 40 : (b > 240 ? 240 : b);
  samplesPerStep = (long)(SR * 60.0 / bpm / 2.0 * (1.0f - tempoNudge));
}

// swing: lengthen the down-beat (even) steps and shorten the off-beat (odd) ones by
// up to ~33%, so each pair still sums to the same time but the groove shuffles.
long stepDuration(int step) {
  float s = swing / 9.0f * 0.33f;
  float f = (step % 2 == 0) ? (1.0f + s) : (1.0f - s);
  // micro-timing looseness: nudge each step +/-1.2% so the grid isn't robotically
  // rigid. Averages out over time, so the overall tempo doesn't drift.
  float hj = 1.0f + 0.012f * noise();
  return (long)(samplesPerStep * f * hj) + (long)stepMicro[step] * 50;
}

