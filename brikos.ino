// roll a step's chance: a hit only fires if a random draw falls under its
// probability. 100 always fires; lower values thin the pattern at random.
inline bool rollChance(int tr, int st) {
  float c = chance[tr][st] * densityScale;
  if (c >= 100.0f) return true;
  if (c <= 0.0f) return false;
  return (noise() * 0.5f + 0.5f) * 100.0f < c;
}

// humanize velocity: drop a hit's level by up to `amt` at random, so repeated
// hits (hats especially) breathe instead of machine-gunning at one flat level.
// Multiplicative on the base, so accents (1.35) still clearly stand above hits.
inline float hvel(float base, float amt) {
  float r = noise() * 0.5f + 0.5f;   // 0..1
  return base * (1.0f - amt * r);
}

void prepareHatChoke() {
  if (soundVariant[2] != 0) return;
  if (chokeHatOnClosed) {
    openTailEnv = 0;
    if (hatWasOpen) hatEnv = 0;
  } else if (hatWasOpen && hatEnv > 1e-4f) {
    openTailEnv = hatEnv; openTailD = hatD > 1.0f ? 1.0f/hatD : hatD;
    openTailBaseF = hatBaseF;
    memcpy(openTailPhase, hatPhase, sizeof(hatPhase));
    openTailLp1 = hNoiseLp1; openTailLp2 = hNoiseLp2;
    openTailHp1 = hatHp; openTailHp2 = hatHp2;
  }
}

bool sequenceHit(int tr, int st) {
  bool filling = fillActive && fillStepsLeft > 0 && tr == fillTrack;
  if (repeatingStep) {
    bool fires = !muted[tr] && (repeatMask & (1 << tr));
    if (fires) triggeredMask |= 1 << tr;
    return fires;
  }
  if (trackNudge[tr] && !filling) { ratchetHits[tr]=0; return false; }
  bool fires = filling ? !muted[tr] : (pattern[tr][st] && rollChance(tr, st));
  ratchetHits[tr] = fires ? (filling ? 2 : constrain((int)ratchet[tr][st], 0, 3) + 1) : 0;
  ratchetNext[tr] = 1;
  ratchetDue[tr] = ratchetHits[tr] > 1 ? curStepDur / ratchetHits[tr] : curStepDur;
  if (fires) triggeredMask |= 1 << tr;
  return fires;
}

void triggerStep() {
  int st = sequenceStepOverride >= 0 ? sequenceStepOverride : currentStep;
  triggeredMask = 0;
  if (!repeatingStep) {
    stepTriggeredMs = millis();
    memset(ratchetHits, 0, sizeof(ratchetHits));
  }
  if (sequenceHit(0, st)) {  // kick
    lastKickMs = millis();
    kickEnv = hvel((pattern[0][st] == 2) ? 1.35f : 1.0f, humanize[0] / 9.0f * 0.3f); kickPitch = 1.0f;
    kickClickEnv = 0.50f;                     // noise burst — initial attack energy
    kickSnapEnv  = 0.80f; kickSnapPhase = 0;  // tonal snap — Elektron BD character
    scEnv = 0.0f;                             // fire the sidechain duck on each kick
    switch (soundVariant[0]) {
      case 0: kickSnapF=200; kBaseF=50; kSweepF=210; kAmpD=decayC(0.34f); kPitchD=decayC(0.038f); kickBodyEnv=0.65f; kickBodyPhase=0; kBodyD=decayC(0.022f); break; // 808
      case 1: kickSnapF=310; kBaseF=55; kSweepF=290; kAmpD=decayC(0.15f); kPitchD=decayC(0.018f); kickBodyEnv=0.90f; kickBodyPhase=0; kBodyD=decayC(0.013f); break; // PUNCH — strongest body for the most chest thump
      case 2: kickSnapF=145; kBaseF=38; kSweepF=115; kAmpD=decayC(0.50f); kPitchD=decayC(0.060f); kickBodyEnv=0.40f; kickBodyPhase=0; kBodyD=decayC(0.030f); break; // SUB — lighter body, deeper sub
      case 3: kickSnapF=390; kBaseF=62; kSweepF=370; kAmpD=decayC(0.09f); kPitchD=decayC(0.012f); kickBodyEnv=0.72f; kickBodyPhase=0; kBodyD=decayC(0.010f); break; // TIGHT
      default:kickSnapF=520; kBaseF=78; kSweepF=520; kAmpD=decayC(0.05f); kPitchD=decayC(0.008f); kickBodyEnv=0.28f; kickBodyPhase=0; kBodyD=decayC(0.008f); break; // CLICK
    }
  }
  if (sequenceHit(1, st)) {  // snare
    snareEnv = hvel((pattern[1][st] == 2) ? 1.35f : 1.0f, humanize[1] / 9.0f * 0.3f);
    snClickEnv = 0.68f;   // brighter crack — Elektron SD character
    snPitch = 1.0f;       // body tone starts ~3.2x high, sweeps down to snToneF — gives the snare its snap
    switch (soundVariant[1]) {
      case 0: snToneF=185; snNoiseMix=0.78f; snD=decayC(0.10f);  snPitchD=decayC(0.012f); snWireEnv=snareEnv*0.60f; break; // NOISE — SD HARD: full wire buzz
      case 1: snToneF=390; snNoiseMix=0.10f; snD=decayC(0.038f); snPitchD=decayC(0.008f); snWireEnv=0;              break; // RIM: no wire (metallic ping)
      case 2: snToneF=155; snNoiseMix=0.58f; snD=decayC(0.16f);  snPitchD=decayC(0.020f); snWireEnv=snareEnv*0.50f; break; // FAT: medium wire
      case 3: snToneF=265; snNoiseMix=0.90f; snD=decayC(0.050f); snPitchD=decayC(0.006f); snWireEnv=snareEnv*0.32f; break; // SNAP: less wire, emphasize crack
      default:snToneF=222; snNoiseMix=0.72f; snD=decayC(0.070f); snPitchD=decayC(0.010f); snWireEnv=snareEnv*0.44f; break; // TIGHT: moderate wire
    }
  }
  if (sequenceHit(2, st)) {  // hihat
    prepareHatChoke();
    hatEnv = hvel((pattern[2][st] == 2) ? 1.35f : 1.0f, humanize[2] / 9.0f * 0.3f);
    hatClickEnv = 0.55f;                      // very short tick (~1.2ms) — gives each hat a defined attack edge
    for (int hk = 0; hk < 6; hk++) hatPhase[hk] = 0;  // reset metallic osc on each hit
    switch (soundVariant[2]) {
      case 0: hatD=decayC(0.016f); hatBaseF=1520.0f; rideBellEnv=0; break; // CLOSED — Elektron precision (16ms, ultra-tight)
      case 1: hatD=decayC(0.20f);  hatBaseF=1080.0f; rideBellEnv=0; break; // OPEN   — sustained metallic shimmer
      case 2: hatD=decayC(0.010f); hatBaseF=1750.0f; rideBellEnv=0; break; // PEDAL  — foot hat, fastest decay
      default:hatD=decayC(0.45f);  hatBaseF=820.0f;  rideBellEnv=0.75f; rideBellPhase=0; break; // RIDE — slow bow shimmer (wider inharmonics) + tonal bell ping
    }
  }
  if (sequenceHit(3, st)) {  // clap / shaker
    clapEnv = hvel((pattern[3][st] == 2) ? 1.35f : 1.0f, humanize[3] / 9.0f * 0.3f);
    clapEnv2 = 0; clapEnv3 = 0;
    switch (soundVariant[3]) {
      case 0: clapD=decayC(0.065f); clapCnt2=330; clapCnt3=730; break; // CLAP — 3-burst Linn/Elektron (7ms, 16ms gaps)
      case 1: clapD=decayC(0.040f); clapCnt2=0;   clapCnt3=0;   break; // SHAKER — single tight
      case 2: clapD=decayC(0.10f);  clapCnt2=200; clapCnt3=0;   break; // TAMB — 2-burst tambourine
      default:clapD=decayC(0.022f); clapCnt2=0;   clapCnt3=0;   break; // SNAP — single ultra-tight
    }
  }
  if (sequenceHit(4, st)) {  // tom
    tomEnv = hvel((pattern[4][st] == 2) ? 1.35f : 1.0f, humanize[4] / 9.0f * 0.3f); tomPitch = 1.0f;
    tomClickEnv = 0.45f;                      // stick impact noise burst — the thud before the sine body
    tomRingEnv = 0.52f; tomRingPhase = 0;     // resonant ring: brief pitched ping above the body (~14ms)
    switch (soundVariant[4]) {
      case 0: tBaseF = 100; tSweepF = 130; tAmpD = decayC(0.22f); tPitchD = decayC(0.08f); break; // low
      case 1: tBaseF = 130; tSweepF = 150; tAmpD = decayC(0.19f); tPitchD = decayC(0.07f); break; // mid
      case 2: tBaseF = 160; tSweepF = 180; tAmpD = decayC(0.16f); tPitchD = decayC(0.06f); break; // high
      default:tBaseF = 80;  tSweepF = 110; tAmpD = decayC(0.28f); tPitchD = decayC(0.10f); break; // floor
    }
  }
  for (int sy = 0; sy < 2; sy++) {              // two synth-bass tracks (B1, B2)
    int tr = 5 + sy;
    if (!muted[tr] && sequenceHit(tr, st)) {
      bool syIdle = (synthEnv[sy] < 1e-4f);
      synthEnv[sy]  = hvel((pattern[tr][st] == 2) ? 1.35f : 1.0f, humanize[tr] / 9.0f * 0.3f);
      const SynthDef& sd = synthDefs[soundVariant[tr]];
      synthWave[sy] = sd.wave;
      synF[sy]      = sd.freq * powf(2.0f, (synthNote[sy][st] + transposeAmt) / 12.0f);  // per-step melody pitch + key transpose
      if (syIdle || glideAmt == 0) synSlideF[sy] = synF[sy];  // snap if idle or glide off
      synD[sy]      = decayC(sd.decay);
      synLPc[sy]    = sd.lp;
      synthFEnv[sy] = 1.0f;                       // fully open the filter, then let it close
      synthFD[sy]   = decayC(sd.decay * 0.6f);    // filter env a touch snappier than the amp
      // voice character from its own fields: saws run wider, low notes carry more
      // sub, dark (low-lp) voices drive harder, bright ones resonate more.
      float fn = sd.freq / 220.0f; if (fn > 1.0f) fn = 1.0f;
      synDet[sy]  = 1.003f + (sd.wave == 0 ? 0.007f : 0.003f) + sd.lp * 0.004f;
      synSubL[sy] = 0.15f + 0.45f * (1.0f - fn);
      synDrv[sy]  = 1.0f + (0.5f - sd.lp) * 1.6f;
      if (synDrv[sy] < 0.6f) synDrv[sy] = 0.6f; if (synDrv[sy] > 2.2f) synDrv[sy] = 2.2f;
      synRes[sy]  = 0.30f + sd.lp * 0.45f;
      synPEnv[sy] = (sd.decay < 0.15f) ? 0.5f : 0.15f;  // plucky voices get a sharper pitch blip
      synPD[sy]   = decayC(0.02f);
      // ---- modular patch: pick an engine archetype from the voice index so the
      // rack spans FM bells, swept supersaws, vibrato leads, FM growls, and
      // wavefolders rather than one shared subtractive tone.
      int vi = soundVariant[tr];
      int arch;
      if (vi < 80)       arch = vi % 5;                  // ANALOG-MODERN: mixed engines
      else if (vi < 100) arch = (vi & 1) ? 3 : 0;        // FM: FM bell / FM growl
      else if (vi < 120) arch = (vi % 3 == 0) ? 1 : 4;  // WEST: swept / wavefolder
      else if (vi < 140) arch = 0;                        // KEYS: FM pluck -> piano/keys transient
      else if (vi < 160) arch = 2;                        // STRINGS: vibrato lead -> tremolo/vibrato bowing
      else               arch = (vi % 3 == 0) ? 3 : 1;  // LEADS: FM growl or swept supersaw
      synLfoPhase[sy] = 0; synModPhase[sy] = 0;
      synFmIdx[sy] = 0; synFmRatio[sy] = 1.0f; synFmEnv[sy] = 0; synFmD[sy] = decayC(0.1f);
      synLfoInc[sy] = (0.6f + (vi % 9) * 0.5f) / SR;   // ~0.6..4.6 Hz mod LFO
      synLfoCut[sy] = 0.06f; synLfoPit[sy] = 0; synFold[sy] = 0;
      switch (arch) {
        case 0: {                                        // FM bell / pluck
          static const float R[6] = { 1.0f, 2.0f, 3.0f, 3.5f, 4.0f, 7.0f };
          synFmRatio[sy] = R[vi % 6];
          synFmIdx[sy]   = 2.0f + (vi % 4);              // bright, inharmonic attack
          synFmEnv[sy]   = 1.0f;
          synFmD[sy]     = decayC(sd.decay * 0.5f);      // index decays -> tone settles
          synLfoCut[sy]  = 0.04f;
          break;
        }
        case 1:                                          // swept supersaw
          synLfoCut[sy] = 0.15f;
          synLfoInc[sy] = (0.35f + (vi % 5) * 0.3f) / SR;
          break;
        case 2:                                          // vibrato lead
          synLfoPit[sy] = 0.010f + (vi % 4) * 0.004f;
          synLfoInc[sy] = (4.0f + (vi % 4)) / SR;        // ~4..7 Hz vibrato
          break;
        case 3: {                                        // FM reese / growl (sustained index)
          static const float R2[4] = { 1.5f, 2.0f, 2.5f, 3.0f };
          synFmRatio[sy] = R2[vi % 4];
          synFmIdx[sy]   = 1.2f + (vi % 3) * 0.6f;
          synFmEnv[sy]   = 1.0f;
          synFmD[sy]     = decayC(sd.decay * 1.5f);      // slow decay -> the growl sustains
          synLfoCut[sy]  = 0.10f;
          synLfoInc[sy]  = (0.3f + (vi % 4) * 0.4f) / SR;
          break;
        }
        default:                                         // wavefolder (west-coast)
          synFold[sy]   = 1.5f + (vi % 4) * 1.2f;
          synLfoCut[sy] = 0.10f;
          break;
      }
    }
  }
  for (int tr = 0; tr < TRACKS; ++tr)
    if (triggeredMask & (1 << tr)) finishVoiceTrigger(tr, st);
}

// per-track output gains — each raw voice is scaled, then run through its FX
float gTrack[TRACKS] = { 0.55f, 0.32f, 0.20f, 0.26f, 0.30f, 0.34f, 0.34f };

// per-track effect assignment (index into fxName order); set in MODE_FX
int trackFX[TRACKS] = { 0, 0, 0, 0, 0, 0, 0 };

// per-track effect state — each track owns its own buffer + state, so the six
// effects run fully independently on their own audio bus.
int16_t  fxBuf[TRACKS][FXBUF];
int      fxWrite[TRACKS] = {0};
uint32_t fxN[TRACKS]     = {0};   // monotonic sample counter (reverb comb/allpass taps)
float    phZ[TRACKS][4]  = {{0}}; // phaser / allpass state
float    lfoPh[TRACKS]   = {0};   // modulation LFO phase
float    oscPh[TRACKS]   = {0};   // ring-mod carrier phase
float    lp1[TRACKS]     = {0};   // per-track one-pole (delay/reverb/phaser damping)
float    lp2[TRACKS]     = {0};   // second one-pole (reverb comb 2)
float    ghold[TRACKS]   = {0};   // sample&hold value (crush)
int      gcnt[TRACKS]    = {0};   // sample&hold counter (crush)
int      stutPos[TRACKS] = {0};   // stutter playback position
int      fxStep[TRACKS]  = {-1,-1,-1,-1,-1,-1,-1}; // last step seen (stutter slice reset)

inline int16_t f2i(float v) { v = v > 1 ? 1 : (v < -1 ? -1 : v); return (int16_t)(v * 32767.0f); }

float applyFX(int tr, float in) {
  int fx = trackFX[tr];
  if (fx == 0) return in;                       // OFF — no work
  int16_t* buf = fxBuf[tr];
  int w = fxWrite[tr];
  const float INV = 1.0f / 32768.0f;
  float out = in;
  switch (fx) {
    case 1: {                                   // DELAY — feedback echo, damped repeats
      int rp = w - DELAY_LEN; if (rp < 0) rp += FXBUF;
      float d = buf[rp] * INV;
      lp1[tr] += 0.35f * (d - lp1[tr]);          // low-pass the feedback so each echo darkens
      out = in + 0.7f * lp1[tr];
      buf[w] = f2i(in + 0.5f * lp1[tr]);
      break;
    }
    case 2: {                                   // REVERB — 2 parallel damped combs + 1 allpass (Schroeder)
      uint32_t n = fxN[tr];
      int p1 = n % RV_C1;
      int p2 = n % RV_C2;
      int pa = n % RV_AP;
      float c1 = buf[p1] * INV;
      float c2 = buf[RV_C1 + p2] * INV;
      lp1[tr] += 0.28f * (c1 - lp1[tr]);         // comb-1 damping (absorbs highs in the tail)
      lp2[tr] += 0.28f * (c2 - lp2[tr]);         // comb-2 damping
      buf[p1]         = f2i(in + 0.80f * lp1[tr]);
      buf[RV_C1 + p2] = f2i(in + 0.80f * lp2[tr]);
      float comb = 0.5f * (c1 + c2);
      float apOld = buf[RV_C1 + RV_C2 + pa] * INV; // allpass diffusion smears the echoes
      float y = -0.5f * comb + apOld;
      buf[RV_C1 + RV_C2 + pa] = f2i(comb + 0.5f * y);
      out = 0.65f * in + 0.5f * y;
      break;
    }
    case 3: {                                   // PHASER — 4 swept allpass stages with light feedback
      lfoPh[tr] += 0.4f * TWO_PI_F / SR; if (lfoPh[tr] > TWO_PI_F) lfoPh[tr] -= TWO_PI_F;
      float a = 0.5f + 0.45f * fastSin(lfoPh[tr]);
      float x = in + 0.3f * lp1[tr];             // resonant feedback deepens the notches
      for (int s = 0; s < 4; s++) {
        float y = -a * x + phZ[tr][s];
        phZ[tr][s] = x + a * y;
        x = y;
      }
      lp1[tr] = x;
      out = 0.5f * (in + x);
      break;
    }
    case 4: {                                   // FLANGE — swept short delay WITH feedback (jet whoosh)
      lfoPh[tr] += 0.25f * TWO_PI_F / SR; if (lfoPh[tr] > TWO_PI_F) lfoPh[tr] -= TWO_PI_F;
      float depth = FLANGE_CTR + FLANGE_DEP * fastSin(lfoPh[tr]);
      int di = (int)depth; float frac = depth - di;
      int rp = w - di; if (rp < 0) rp += FXBUF;
      int rp2 = rp - 1; if (rp2 < 0) rp2 += FXBUF;
      float d = (buf[rp] * (1.0f - frac) + buf[rp2] * frac) * INV;
      out = 0.7f * in + 0.7f * d;
      buf[w] = f2i(in + 0.55f * d);              // feedback resonates the swept comb
      break;
    }
    case 5: {                                   // CHORUS — dual-tap modulated delay, real thickening
      lfoPh[tr] += 0.8f * TWO_PI_F / SR; if (lfoPh[tr] > TWO_PI_F) lfoPh[tr] -= TWO_PI_F;
      buf[w] = f2i(in);
      float wet = 0;
      float d1 = CHORUS_CTR + CHORUS_DEP * fastSin(lfoPh[tr]);
      float d2 = CHORUS_CTR + CHORUS_DEP * fastSin(lfoPh[tr] + 2.09f);  // 2nd voice 120deg out of phase
      int di = (int)d1; float fr = d1 - di;
      int rp = w - di; if (rp < 0) rp += FXBUF;
      int rp2 = rp - 1; if (rp2 < 0) rp2 += FXBUF;
      wet += (buf[rp] * (1.0f - fr) + buf[rp2] * fr) * INV;
      di = (int)d2; fr = d2 - di;
      rp = w - di; if (rp < 0) rp += FXBUF;
      rp2 = rp - 1; if (rp2 < 0) rp2 += FXBUF;
      wet += (buf[rp] * (1.0f - fr) + buf[rp2] * fr) * INV;
      out = 0.7f * in + 0.4f * wet;
      break;
    }
    case 6: {                                   // DRIVE — tanh waveshaper (warm overdrive / saturation)
      out = fastTanh(in * 4.0f) * 0.72f;         // 0.72 trims the hot shaped level back toward the dry
      break;
    }
    case 7: {                                   // CRUSH — sample-rate + bit-depth reduction (lo-fi grit)
      if (gcnt[tr] <= 0) { ghold[tr] = in; gcnt[tr] = 4; }  // downsample x4
      gcnt[tr]--;
      out = floorf(ghold[tr] * 16.0f + 0.5f) / 16.0f;      // ~5-bit quantize (grittier than clean, not mud)
      break;
    }
    case 8: {                                   // TREMOLO — amplitude LFO
      lfoPh[tr] += 5.0f * TWO_PI_F / SR; if (lfoPh[tr] > TWO_PI_F) lfoPh[tr] -= TWO_PI_F;
      out = in * (0.4f + 0.6f * (0.5f + 0.5f * fastSin(lfoPh[tr])));
      break;
    }
    case 9: {                                   // RINGMOD — multiply by a fixed carrier (metallic / bell)
      oscPh[tr] += 180.0f * TWO_PI_F / SR; if (oscPh[tr] > TWO_PI_F) oscPh[tr] -= TWO_PI_F;
      out = in * fastSin(oscPh[tr]);
      break;
    }
    default: {                                  // STUTTER — tempo-synced beat-repeat: grab a slice, loop it
      if (fxStep[tr] != currentStep) { fxStep[tr] = currentStep; stutPos[tr] = 0; }
      int sliceLen = (int)(samplesPerStep / 4);  // capture the first quarter of the step...
      if (sliceLen < 1) sliceLen = 1;
      if (sliceLen > FXBUF) sliceLen = FXBUF;
      if (stutPos[tr] < sliceLen) { buf[stutPos[tr]] = f2i(in); out = in; }  // record + pass through
      else                        { out = buf[stutPos[tr] % sliceLen] * INV; } // ...then loop it, locked to tempo
      stutPos[tr]++;
      break;
    }
  }
  fxWrite[tr] = (w + 1) % FXBUF;
  fxN[tr]++;
  return out;
}

// one oscillator sample: waveform + phase (0..1) + phase increment dt. The
// saw/square/pulse edges are PolyBLEP-corrected so they don't alias; sine and
// triangle are already band-limited enough (harmonics roll off fast) to pass.
inline float oscWave(int wv, float ph, float dt) {
  if (wv == 2) return fastSinP(ph);                        // sine
  if (wv == 3) return 4.0f * fabsf(ph - 0.5f) - 1.0f;      // triangle
  if (wv == 1) {                                           // square — blep both edges
    float y = ph < 0.5f ? 1.0f : -1.0f;
    y += polyBlep(ph, dt);
    float p2 = ph + 0.5f; if (p2 >= 1.0f) p2 -= 1.0f;      // falling edge at 0.5
    y -= polyBlep(p2, dt);
    return y;
  }
  if (wv == 4) {                                           // narrow pulse (25%) — blep both edges
    float y = ph < 0.25f ? 1.0f : -1.0f;
    y += polyBlep(ph, dt);
    float p2 = ph + 0.75f; if (p2 >= 1.0f) p2 -= 1.0f;     // falling edge at 0.25
    y -= polyBlep(p2, dt);
    return y;
  }
  float y = 2.0f * ph - 1.0f;                              // saw — blep the wrap edge
  y -= polyBlep(ph, dt);
  return y;
}

float synthSample() {
  // Each voice is gated on its envelope: a voice below the audible floor skips
  // its whole oscillator/filter/tanh computation (it would output ~0 anyway), so
  // idle voices cost nothing and only the voices actually sounding use CPU.
  const float FLOOR = 1e-4f;
  // Fixed decay coefficients were initialized in setup().

  // kick: pitch-swept sine with fast pitch decay + slower amp decay
  float k = 0.0f;
  if (kickEnv > FLOOR) {
    float freq = kBaseF + kSweepF * kickPitch;
    kickPhase += TWO_PI_F * freq / SR;
    if (kickPhase > TWO_PI_F) kickPhase -= TWO_PI_F;
    k = fastSin(kickPhase) * kickEnv;
    k += 0.10f * fastSin(kickPhase * 2.0f) * kickEnv * kickPitch;  // 2nd harmonic: mid punch at attack, fades naturally as pitch sweeps to sub
    kickPitch *= kPitchD;
    advanceVoiceEnvelope(0, kickEnv, kAmpD);
  }
  if (kickClickEnv > FLOOR) {                // noise burst — raw attack energy
    k += noise() * kickClickEnv * 0.22f;
    kickClickEnv *= d003;          // ~3ms
  }
  if (kickSnapEnv > FLOOR) {                 // tonal snap: brief high-freq sine (Elektron BD character)
    kickSnapPhase += TWO_PI_F * kickSnapF / SR;
    if (kickSnapPhase > TWO_PI_F) kickSnapPhase -= TWO_PI_F;
    k += fastSin(kickSnapPhase) * kickSnapEnv * 0.28f;
    kickSnapEnv *= d0025;          // ~2.5ms — tighter than the noise for a defined "knock"
  }
  if (kickBodyEnv > FLOOR) {                 // mid-body thump: resonant ring above the sub, the chest-punch layer
    float bF = kBaseF * 2.5f + kSweepF * kickPitch;  // tracks the pitch sweep for natural character
    kickBodyPhase += bF / SR;
    if (kickBodyPhase >= 1.0f) kickBodyPhase -= 1.0f;
    k += fastSinP(kickBodyPhase) * kickBodyEnv * 0.20f;
    kickBodyEnv *= kBodyD;                   // variant-specific decay: PUNCH=13ms, 808=22ms, SUB=30ms
  }

  // snare / rimshot / fat: noise + body tone in a preset ratio
  float s = 0.0f;
  if (snareEnv > FLOOR) {
    float sFreq = snToneF * (1.0f + 2.2f * snPitch);  // body pitch starts ~3.2x snToneF, sweeps down — the real source of snare snap
    snarePhase += TWO_PI_F * sFreq / SR;
    if (snarePhase > TWO_PI_F) snarePhase -= TWO_PI_F;
    float rawN = noise();
    snHp += 0.08f * (rawN - snHp);                    // one-pole LP tracker
    s = (snNoiseMix * (rawN - snHp)                   // highpassed noise — bright, airy crack instead of dull hiss
       + (1.0f - snNoiseMix) * fastSin(snarePhase)) * snareEnv;
    snPitch *= snPitchD;
    advanceVoiceEnvelope(1, snareEnv, snD);
  }
  if (snClickEnv > FLOOR) {                  // crack transient: sharp noise burst
    s += noise() * snClickEnv * 0.35f;
    snClickEnv *= d004;            // ~4ms — tighter crack for Elektron SD
  }
  if (snWireEnv > FLOOR) {                   // snare wire buzz: bandpass noise at wire resonance frequency
    float wn = noise();
    snWireLp  += 0.78f * (wn - snWireLp);   // broad LP (~17kHz)
    snWireLp2 += 0.55f * (wn - snWireLp2);  // narrower LP (~12kHz) -> bandpass = upper sizzle only
    s += (snWireLp - snWireLp2) * snWireEnv * 0.48f;
    snWireEnv *= d055;             // ~55ms buzz — the characteristic sizzle of snare wires rattling
  }

  // hihat: inharmonic metallic oscillators + noise — real cymbal character
  float h = 0.0f;
  if (hatEnv > FLOOR) {
    // 6 SINE oscillators at TR-909 inharmonic ratios — sine is band-limited
    // by nature (zero aliasing), and the inharmonic ratios ARE the metallic
    // character. Square waves at these frequencies alias past Nyquist even with
    // PolyBLEP, producing the harsh buzzy "h" the user heard.
    static const float HR_HAT[6]  = { 1.0f, 1.483f, 1.932f, 2.646f, 3.161f, 4.234f };
    static const float HR_RIDE[6] = { 1.0f, 1.483f, 2.215f, 3.496f, 4.127f, 5.831f };
    static const float HG[6]      = { 0.50f, 0.42f, 0.32f, 0.22f, 0.15f, 0.10f };
    const float* HR = (soundVariant[2] == 3) ? HR_RIDE : HR_HAT;
    float hsum = 0;
    for (int hk = 0; hk < 6; hk++) {
      float hf = hatBaseF * HR[hk];
      hatPhase[hk] += hf / SR; if (hatPhase[hk] >= 1.0f) hatPhase[hk] -= 1.0f;
      hsum += fastSinP(hatPhase[hk]) * HG[hk];   // sine: metallic without aliasing
    }
    hsum *= 1.85f;  // compensate for HG sum < 1
    // bandpass-shaped noise: two LP stages at very different speeds subtracted
    // gives a sizzle band in the upper-mids, not flat white-noise hiss
    float rawN = noise();
    hNoiseLp1 += 0.55f * (rawN - hNoiseLp1);    // broad LP (~12kHz)
    hNoiseLp2 += 0.04f * (rawN - hNoiseLp2);    // narrow LP (~880Hz)
    float bandN = hNoiseLp1 - hNoiseLp2;         // bandpass sizzle
    float noiseAmt = (soundVariant[2] == 3) ? 0.10f : 0.25f;
    float hRaw = ((1.0f - noiseAmt) * hsum + noiseAmt * bandN * 3.5f) * hatEnv;
    // 2-pole highpass cascade — steeper rolloff strips the low mud cleanly
    hatHp  += 0.14f * (hRaw - hatHp);
    float hp1 = hRaw - hatHp;
    hatHp2 += 0.14f * (hp1 - hatHp2);
    h = (hp1 - hatHp2) * 1.4f;
    advanceVoiceEnvelope(2, hatEnv, hatD);
  }
  if (openTailEnv > FLOOR) {
    static const float ratios[6] = {1.0f,1.483f,1.932f,2.646f,3.161f,4.234f};
    static const float gains[6] = {0.50f,0.42f,0.32f,0.22f,0.15f,0.10f};
    float sum = 0;
    for (int j = 0; j < 6; j++) {
      openTailPhase[j] += openTailBaseF * ratios[j] / SR;
      if (openTailPhase[j] >= 1) openTailPhase[j] -= 1;
      sum += fastSinP(openTailPhase[j]) * gains[j];
    }
    float n = noise();
    openTailLp1 += 0.55f * (n - openTailLp1);
    openTailLp2 += 0.04f * (n - openTailLp2);
    float raw = (0.75f * sum * 1.85f + 0.25f * (openTailLp1 - openTailLp2) * 3.5f) * openTailEnv;
    openTailHp1 += 0.14f * (raw - openTailHp1);
    float hp = raw - openTailHp1;
    openTailHp2 += 0.14f * (hp - openTailHp2);
    h += (hp - openTailHp2) * 1.4f;
    openTailEnv *= openTailD;
  }
  if (rideBellEnv > FLOOR) {                      // ride bell — tonal sine at the dome (~465Hz, ~220ms decay)
    rideBellPhase += 465.0f / SR;                  // dome pitch; keeps good ratio with 820Hz bow base
    if (rideBellPhase >= 1.0f) rideBellPhase -= 1.0f;
    h += fastSinP(rideBellPhase) * rideBellEnv * 0.42f;
    rideBellEnv *= d22;                  // bell decays faster than the bow shimmer
  }
  if (hatClickEnv > FLOOR) {                      // very short tick (~1.2ms) — the "tik" attack that makes hats feel defined
    h += noise() * hatClickEnv * 0.35f;
    hatClickEnv *= d0012;
  }

  // clap / shaker: noise burst
  float c = 0.0f;
  if (clapEnv > FLOOR) { c += noise() * clapEnv; advanceVoiceEnvelope(3, clapEnv, clapD); }
  if (clapCnt2 > 0 && --clapCnt2 == 0) clapEnv2 = 0.55f;    // fire secondary burst (~7ms late)
  if (clapCnt3 > 0 && --clapCnt3 == 0) clapEnv3 = 0.35f;    // fire tertiary  burst (~16ms late)
  if (clapEnv2 > FLOOR) { c += noise() * clapEnv2 * 0.70f; clapEnv2 *= d055; }
  if (clapEnv3 > FLOOR) { c += noise() * clapEnv3 * 0.45f; clapEnv3 *= d070; }

  if (clapPitchRatio != 1.0f) {
    clapPitchLP += clapPitchCoef * (c-clapPitchLP);
    c = clapPitchRatio < 1.0f ? clapPitchLP : c + (1.0f-1.0f/clapPitchRatio)*(c-clapPitchLP);
  }

  // tom: pitch-swept sine + stick impact noise burst
  float t = 0.0f;
  if (tomEnv > FLOOR) {
    float tfreq = tBaseF + tSweepF * tomPitch;
    tomPhase += TWO_PI_F * tfreq / SR;
    if (tomPhase > TWO_PI_F) tomPhase -= TWO_PI_F;
    t = fastSin(tomPhase) * tomEnv;
    tomPitch *= tPitchD;
    advanceVoiceEnvelope(4, tomEnv, tAmpD);
  }
  if (tomClickEnv > FLOOR) {                      // stick impact — the thud/click before the body, makes toms sound struck
    t += noise() * tomClickEnv * 0.28f;
    tomClickEnv *= d004;                // ~4ms
  }
  if (tomRingEnv > FLOOR) {                  // resonant ring: brief pitched ping above the tom body
    tomRingPhase += (tBaseF * 2.8f) / SR;
    if (tomRingPhase >= 1.0f) tomRingPhase -= 1.0f;
    t += fastSinP(tomRingPhase) * tomRingEnv * 0.20f;
    tomRingEnv *= d014;            // ~14ms — the "thwock" of the stick on the skin
  }

  // two synth-bass voices, each now a 3-oscillator stack (main + detuned unison
  // + sub octave) through a resonant 2-pole lowpass with its own envelope, then
  // lightly driven — the difference between a thin beep and a fat analog bass.
  float ysyn[2];
  for (int sy = 0; sy < 2; sy++) {
    if (muted[5 + sy] || synthEnv[sy] <= FLOOR) { ysyn[sy] = 0.0f; continue; }  // idle synth voice — skip its whole stack
    // modular mod source: one LFO patched to cutoff and/or pitch this voice
    synLfoPhase[sy] += synLfoInc[sy]; if (synLfoPhase[sy] >= 1.0f) synLfoPhase[sy] -= 1.0f;
    float lfo = fastSinP(synLfoPhase[sy]);                        // -1..1
    float pMod = (1.0f + 0.6f * synPEnv[sy]) * (1.0f + synLfoPit[sy] * lfo);  // pitch-env blip + LFO vibrato
    const float glC = (glideAmt == 0) ? 0.0f : (0.9975f + glideAmt * 0.00025f);
    synSlideF[sy] = synSlideF[sy] * glC + synF[sy] * (1.0f - glC);  // portamento slide
    float inc = synSlideF[sy] * pMod / SR;
    float raw;
    if (synFmIdx[sy] > 0.0f) {                                    // ---- 2-operator FM engine ----
      synModPhase[sy]   += inc * synFmRatio[sy]; if (synModPhase[sy]   >= 1.0f) synModPhase[sy]   -= 1.0f;
      synthPhase[sy]    += inc;                  if (synthPhase[sy]    >= 1.0f) synthPhase[sy]    -= 1.0f;
      synthSubPhase[sy] += inc * 0.5f;           if (synthSubPhase[sy] >= 1.0f) synthSubPhase[sy] -= 1.0f;
      float m = fastSinP(synModPhase[sy]) * synFmIdx[sy] * synFmEnv[sy];  // modulator, index-enveloped
      raw = 0.85f * fastSinP(synthPhase[sy] + m)                 // phase-modulated sine carrier
          + synSubL[sy] * fastSinP(synthSubPhase[sy]);           // sub sine -> weight
      synFmEnv[sy] *= synFmD[sy];                                // index decays -> the tone evolves
    } else {                                                     // ---- subtractive supersaw ensemble ----
      synthPhase[sy]    += inc;             if (synthPhase[sy]    >= 1.0f) synthPhase[sy]    -= 1.0f;
      synthPhaseB[sy]   += inc * synDet[sy];if (synthPhaseB[sy]   >= 1.0f) synthPhaseB[sy]   -= 1.0f;  // unison detuned up
      synthPhaseC[sy]   += inc * (2.0f - synDet[sy]); if (synthPhaseC[sy] >= 1.0f) synthPhaseC[sy] -= 1.0f;  // detuned down -> ensemble
      synthSubPhase[sy] += inc * 0.5f;      if (synthSubPhase[sy] >= 1.0f) synthSubPhase[sy] -= 1.0f;  // one octave down
      raw = 0.42f * oscWave(synthWave[sy], synthPhase[sy],  inc)                      // main
          + 0.30f * oscWave(synthWave[sy], synthPhaseB[sy], inc * synDet[sy])         // detuned up   -> width
          + 0.30f * oscWave(synthWave[sy], synthPhaseC[sy], inc * (2.0f - synDet[sy]))// detuned down -> ensemble
          + synSubL[sy] * fastSinP(synthSubPhase[sy]); // sub sine -> per-voice weight
    }
    // resonant 4-pole lowpass (Moog-style cascade); cutoff opens with filter envelope + LFO
    float cut = synLPc[sy] + (0.85f - synLPc[sy]) * synthFEnv[sy] * synthFEnv[sy] + synLfoCut[sy] * lfo;
    if (cut > 0.85f) cut = 0.85f; if (cut < 0.02f) cut = 0.02f;
    float fb = synRes[sy] * (1.0f - 0.15f * cut);              // per-voice bounded resonance
    synthLP[sy]  += cut * (raw - synthLP[sy] + fb * (synthLP[sy] - synthLP2[sy]));
    synthLP2[sy] += cut * (synthLP[sy]  - synthLP2[sy]);
    synthLP3[sy] += cut * (synthLP2[sy] - synthLP3[sy]);        // 3rd pole — 24dB/oct rolloff
    synthLP4[sy] += cut * (synthLP3[sy] - synthLP4[sy]);        // 4th pole — smoother bass tail
    float filt = fastTanh(synthLP4[sy] * synDrv[sy]);          // per-voice drive -> harmonics
    if (synFold[sy] > 0.0f) filt = fastSin(filt * synFold[sy]);// wavefolder -> west-coast harmonics
    // gentle high-shelf "air": lift the presence band a touch so voices read
    // modern and open instead of dull/boxy-90s, without reopening the filter.
    synthHP[sy] += 0.35f * (filt - synthHP[sy]);
    float voiced = filt + 0.12f * (filt - synthHP[sy]);   // gentler air -> less harsh top on every voice
    synthAmp[sy] += 0.03f * (synthEnv[sy] - synthAmp[sy]);    // short attack slew kills the click transient
    ysyn[sy] = voiced * synthAmp[sy];
    advanceVoiceEnvelope(5 + sy, synthEnv[sy], synD[sy]);
    synthFEnv[sy] *= synthFD[sy];
    synPEnv[sy]   *= synPD[sy];
  }

  if (kickEnv  > kickPeak)  kickPeak  = kickEnv;
  if (snareEnv > snarePeak) snarePeak = snareEnv;
  if (hatEnv   > hatPeak)   hatPeak   = hatEnv;

  // per-track FX: each track's raw voice is scaled then run through its own
  // effect slot (set in MODE_FX) before the six buses are summed.
  scEnv += (1.0f - scEnv) * SC_REL;             // recover the duck between kicks
  float duck = 1.0f - sidechainDepth * (1.0f - scEnv);
  float raw[TRACKS] = { k, s, h, c, t, ysyn[0], ysyn[1] };
  float mix = 0;
  sceneVerbInput = 0.0f;
  for (int tr = 0; tr < TRACKS; tr++) {
    float g = raw[tr] * ((morphActive || morphTransient) ? morphGain[tr] : gTrack[tr]);
    if (tr != 0) g *= duck;                     // kick stays full; everything else pumps
    float trackOut = applyFX(tr, muted[tr] ? 0.0f : g);
    mix += trackOut;
    sceneVerbInput += trackOut * ((morphActive || morphTransient) ? morphSend[tr] : reverbSend[tr]);
  }
  // soft limiter (tanh) instead of hard clipping — rounds off peaks when several
  // voices stack on one step, so loud hits saturate smoothly instead of tearing
  mix = fastTanh(mix * 1.4f);
  return mix;
}

// ---- Global glitch FX — one effect over the whole summed mix, set in
// MODE_GLITCH. Only one runs at a time, so its cost is a single effect's worth.
int      globalFX = 0;                  // index into gfxName order (0 = OFF)
int16_t  gBuf[GFXBUF];                  // continuous recording of the mix
int      gW = 0;                        // write head
uint32_t gN = 0;                        // free-running sample counter (gate/stutter)
int      gStep = -1, gPos = 0;          // step boundary + position within the step
float    gLfo = 0, gOsc = 0, gLp = 0;   // filter/ringmod state
float    gHold = 0; int gCnt = 0;       // sample & hold (decimate)
float    gTape = 1.0f, gRead = 0;       // tapestop read speed + fractional read head
int      gFreezeW = 0;                  // gW captured at each step boundary — used by FREEZE glitch FX
int      gReverseHead = 0, gReverseLeft = 0; // audio-owned backwards slice cursor
uint32_t grng = 0x9e3779b9u;
inline float gnoise() { grng ^= grng<<13; grng ^= grng>>17; grng ^= grng<<5; return (int32_t)grng / 2147483648.0f; }

const char* gfxName(int f) {
  const char* n[] = { "OFF", "CRUSH", "DECIMATE", "GATE", "REPEAT", "REVERSE",
                      "FILTER", "WOBBLE", "RINGMOD", "ROBOT", "TAPESTOP",
                      "VINYL", "STUTTER", "FREEZE", "STAMMER", "WARP" };
  return n[f];
}

float applyGlobalFX(float in) {
  int fx = globalFX;
  if (fx != 5) gReverseLeft = 0;
  if (fx == 0) return in;
  const float INV = 1.0f / 32768.0f;
  int slice = (int)(samplesPerStep / 2); if (slice < 1) slice = 1; if (slice > GFXBUF) slice = GFXBUF;
  if (currentStep != gStep) { gStep = currentStep; gPos = 0; gTape = 1.0f; gRead = (float)gW; gFreezeW = gW; }  // step boundary
  gBuf[gW] = f2i(in);                    // continuous recording for buffer-based effects
  float out = in;
  switch (fx) {
    case 1:  // CRUSH — hard bit-depth crush (~3-bit)
      out = floorf(in * 6.0f + 0.5f) / 6.0f;
      break;
    case 2:  // DECIMATE — sample-rate crush (sample & hold x6)
      if (gCnt <= 0) { gHold = in; gCnt = 6; }
      gCnt--; out = gHold;
      break;
    case 3: { // GATE — tempo-synced rhythmic on/off chop
      int period = slice / 2; if (period < 1) period = 1;
      out = ((gN % (uint32_t)period) < (uint32_t)(period * 0.55f)) ? in : 0.0f;
      break;
    }
    case 4: { // REPEAT — grab the first eighth of the step, loop it (beat-repeat)
      int rl = slice / 2; if (rl < 1) rl = 1; if (rl > GFXBUF) rl = GFXBUF;
      if (gPos < rl) { gBuf[gPos] = f2i(in); out = in; }   // record + pass through
      else           { out = gBuf[gPos % rl] * INV; }       // ...then loop it, locked to tempo
      break;
    }
    case 5: { // REVERSE — consume a completed slice newest-to-oldest
      // At most half the ring: the forward writer cannot overwrite the
      // unread end of this backwards slice, including at slow tempos.
      if (gPos == 0 || gReverseLeft == 0) {
        gReverseLeft = min(slice, GFXBUF / 2);
        gReverseHead = (gW + GFXBUF - 1) % GFXBUF;
      }
      out = gBuf[gReverseHead] * INV;
      gReverseHead = (gReverseHead + GFXBUF - 1) % GFXBUF;
      --gReverseLeft;
      break;
    }
    case 6: { // FILTER — slow lowpass LFO sweep
      gLfo += 0.5f * TWO_PI_F / SR; if (gLfo > TWO_PI_F) gLfo -= TWO_PI_F;
      float cut = 0.04f + 0.35f * (0.5f + 0.5f * fastSin(gLfo));
      gLp += cut * (in - gLp); out = gLp;
      break;
    }
    case 7: { // WOBBLE — fast lowpass LFO (dubstep wub)
      gLfo += 4.0f * TWO_PI_F / SR; if (gLfo > TWO_PI_F) gLfo -= TWO_PI_F;
      float cut = 0.03f + 0.40f * (0.5f + 0.5f * fastSin(gLfo));
      gLp += cut * (in - gLp); out = gLp * 1.4f;
      break;
    }
    case 8: { // RINGMOD — multiply by a high carrier (metallic)
      gOsc += 300.0f * TWO_PI_F / SR; if (gOsc > TWO_PI_F) gOsc -= TWO_PI_F;
      out = in * fastSin(gOsc);
      break;
    }
    case 9: { // ROBOT — low carrier ringmod mixed with dry (voice-of-machine)
      gOsc += 80.0f * TWO_PI_F / SR; if (gOsc > TWO_PI_F) gOsc -= TWO_PI_F;
      out = 0.5f * in + 0.6f * in * fastSin(gOsc);
      break;
    }
    case 10: { // TAPESTOP — per-step pitch dip: read head slows across the step
      gTape -= 1.0f / (slice * 2.0f); if (gTape < 0.25f) gTape = 0.25f;
      gRead += gTape;
      int ri = (int)gRead; float fr = gRead - ri;
      int i0 = ((ri % GFXBUF) + GFXBUF) % GFXBUF;
      int i1 = (i0 + 1) % GFXBUF;
      out = (gBuf[i0] * (1.0f - fr) + gBuf[i1] * fr) * INV;
      break;
    }
    case 11: { // VINYL — gentle lowpass + random crackle (lo-fi record)
      gLp += 0.25f * (in - gLp);
      float crackle = (gnoise() > 0.985f) ? gnoise() * 0.5f : 0.0f;
      out = gLp + crackle;
      break;
    }
    case 12: { // STUTTER — fast fixed-rate gate chop (~31ms)
      int period = SR / 32; if (period < 1) period = 1;
      out = ((gN % (uint32_t)period) < (uint32_t)(period * 0.6f)) ? in : 0.0f;
      break;
    }
    case 13: { // FREEZE — loop the audio from just before this step (time-stop hold)
      int rl = slice; if (rl < 1) rl = 1; if (rl > GFXBUF - 1) rl = GFXBUF - 1;
      int rp = (gFreezeW - rl + gPos % rl + GFXBUF * 4) % GFXBUF;
      out = gBuf[rp] * INV;
      break;
    }
    case 14: { // STAMMER — rapid 8ms stutter (st-st-st staccato chop)
      int rl = (int)(SR * 0.008f); if (rl < 1) rl = 1;
      if (gPos < rl) { out = in; }
      else { int rp = (gW - (gPos % rl) + GFXBUF * 4) % GFXBUF; out = gBuf[rp] * INV; }
      break;
    }
    case 15: { // WARP — read buffer at slowly drifting speed (tape pitch-wobble / wow)
      gLfo += 1.5f * TWO_PI_F / SR; if (gLfo > TWO_PI_F) gLfo -= TWO_PI_F;
      float speed = 0.88f + 0.24f * (0.5f + 0.5f * fastSin(gLfo));   // 0.88..1.12x
      gRead += speed;
      if (gRead >= GFXBUF) gRead -= GFXBUF; if (gRead < 0) gRead += GFXBUF;
      int ri = (int)gRead; float fr = gRead - ri;
      int ri2 = (ri + 1) % GFXBUF;
      out = (gBuf[ri] * (1.0f - fr) + gBuf[ri2] * fr) * INV;
      break;
    }
    default: out = in; break;
  }
  gW = (gW + 1) % GFXBUF;
  gN++; gPos++;
  out = in + glitchDepth * (out - in);
  return out;
}

// ---- Master bus glue — one processor over the whole summed mix, after the
// global glitch FX: a DC blocker to keep the low end tight, then a soft-knee
// glue compressor with makeup gain so the tracks sit together as one cohesive,
// louder mix instead of a sum of separate voices, finished with a soft-clip so
// the makeup gain can never tear.
float mstEnv = 0.0f, dcX1 = 0.0f, dcY1 = 0.0f;
float mstTone = 0.0f;             // master HF tame — rolls the very top off the whole mix so nothing bites
inline float masterBus(float x) {
  float y = x - dcX1 + 0.9995f * dcY1;          // ~5Hz one-pole highpass (DC blocker)
  dcX1 = x; dcY1 = y;
  float a = fabsf(y);
  float coef = (a > mstEnv) ? 0.20f : 0.0025f;  // fast attack, slow release
  mstEnv += coef * (a - mstEnv);
  float gain = 1.0f;
  if (mstEnv > compThr) gain = (compThr + (mstEnv - compThr) * 0.33f) / mstEnv;  // ~3:1 above threshold
  float g2 = fastTanh(y * gain * 1.22f);        // makeup gain glues + lifts; soft-clip caps peaks
  mstTone += 0.55f * (g2 - mstTone);            // gentle one-pole LP over the master -> softens harshness across all presets
  return mstTone;
}

// ---- Master send reverb — a small always-on room after the glue bus, so the
// mix sits in a shared space instead of bone-dry. Two damped Schroeder combs
// (dark, natural tail) into one diffusion allpass, mixed back at a low wet send
// so it adds air and depth without washing the transients out.
#define MV_C1 1687
#define MV_C2 1601
#define MV_AP 347
int16_t mvC1[MV_C1], mvC2[MV_C2], mvAp[MV_AP];
int mvP1 = 0, mvP2 = 0, mvPa = 0;
float mvLp1 = 0, mvLp2 = 0;
#define MV_PRE 1102           // ~25ms pre-delay at 44100Hz — punchy transients before the tails bloom
int16_t mvPre[MV_PRE];
int mvPreW = 0;
inline float masterVerb(float x) {
  const float INV = 1.0f / 32768.0f;
  // ~25ms pre-delay: the dry signal passes through undelayed, but the reverb combs
  // only receive it 25ms later. Transients punch first, the room blooms behind them
  // — this separation is the single most audible difference between a produced
  // reverb and a muddy one.
  mvPre[mvPreW] = f2i(fastTanh(sceneVerbInput * 1.4f)); // independent per-track sends to the shared room
  float xd = mvPre[(mvPreW + 1) % MV_PRE] * INV;  // 25ms-delayed feed into the comb tails
  mvPreW = (mvPreW + 1) % MV_PRE;
  float c1 = mvC1[mvP1] * INV;
  float c2 = mvC2[mvP2] * INV;
  mvLp1 += 0.30f * (c1 - mvLp1);              // comb-1 damping (absorbs highs in the tail)
  mvLp2 += 0.30f * (c2 - mvLp2);             // comb-2 damping
  mvC1[mvP1] = f2i(xd + 0.82f * mvLp1);
  mvC2[mvP2] = f2i(xd + 0.82f * mvLp2);
  mvP1 = (mvP1 + 1) % MV_C1;
  mvP2 = (mvP2 + 1) % MV_C2;
  float comb = 0.5f * (c1 + c2);
  float apOld = mvAp[mvPa] * INV;             // allpass diffusion smears the tail
  float y = -0.5f * comb + apOld;
  mvAp[mvPa] = f2i(comb + 0.5f * y);
  mvPa = (mvPa + 1) % MV_AP;
  return x + 0.18f * y * ((morphActive || morphTransient) ? morphVerb : masterVerbAmt);                        // subtle wet send — depth, not a wash
}

#include "performance_clock.h"
#include "performance_controls.h"

void generateAndWrite() {
  static int16_t buf[BLOCK * 2];
  uint32_t _t0 = micros();
  for (int i = 0; i < BLOCK; i++) {
    if (playing) {
      if (sampleAccum >= curStepDur) {
        sampleAccum -= curStepDur;
        currentStep = (currentStep + 1) % STEPS;
        lastStepMs = millis();
        if (currentStep == 0 || currentStep == 4) lastDownbeatMs = millis();
        if (currentStep == 0) wrapAdvance = true;  // loop() owns all arrangement changes
        ++performanceStep;
        curStepDur = nextStepDuration > 0 ? nextStepDuration : stepDuration(currentStep);
        nextStepDuration = stepDuration((currentStep + 1) % STEPS);
        advanceFillBar();
        triggerStep();
        planNudges(false);
      }
      repeatMask = 0;
      for (int tr = 0; tr < TRACKS; tr++) {
        if (ratchetNext[tr] < ratchetHits[tr] && sampleAccum >= ratchetDue[tr]) {
          repeatMask |= 1 << tr;
          ratchetNext[tr]++;
          ratchetDue[tr] = curStepDur * ratchetNext[tr] / ratchetHits[tr];
        }
      }
      if (repeatMask) {
        repeatingStep = true;
        triggerStep(); // same voice, accent and melody as the initial hit, all seven tracks
        repeatingStep = false;
      }
      serviceNudges();
      sampleAccum++;
      ++audioSampleClock;
    }
    float mixed = masterVerb(masterBus(applyGlobalFX(synthSample())));  // glitch FX, glue bus, then send reverb
    if (metronome && (currentStep == 0 || currentStep == 4) && sampleAccum < SR / 100) {
      float fade = 1.0f - (float)sampleAccum / (SR / 100);
      mixed += 0.1f * fade * fastSinP(sampleAccum * (1000.0f / SR));
    }
    int16_t v = f2i(mixed * MASTER_VOL * (volume / 10.0f) * (32000.0f / 32767.0f));
    buf[2 * i] = v;
    buf[2 * i + 1] = v;
  }
  uint32_t _dt = micros() - _t0;
  if (_dt > genMaxUs) genMaxUs = _dt;
  genSumUs += _dt; genBlocks++;
  size_t bytesWritten;
  i2s_write(I2S_NUM_0, buf, sizeof(buf), &bytesWritten, portMAX_DELAY);
  scopeBuf[scopeHead] = buf[2 * (BLOCK - 1)];
  scopeHead = (scopeHead + 1) % 32;
}

// Audio runs in its own task on core 0 so the display's blocking SPI push and
// the NeoPixel's interrupt-disabling show() (both on core 1 with loop()) can
// never starve the I2S DMA feed. i2s_write blocks, pacing the task in realtime.
void audioTask(void *param) {
  // Install the I2S driver HERE, from the audio task, so its DMA interrupt is
  // registered on core 0 (this task's core). If it were installed in setup()
  // (core 1), the I2S ISR would fire on core 1 mid-way through matrix.show(),
  // corrupting the WS2812 bit timing and latching the LEDs to flickering white.
  i2s_config_t cfg = {
    .mode = (i2s_mode_t)(I2S_MODE_MASTER | I2S_MODE_TX),
    .sample_rate = SR,
    .bits_per_sample = I2S_BITS_PER_SAMPLE_16BIT,
    .channel_format = I2S_CHANNEL_FMT_RIGHT_LEFT,
    .communication_format = I2S_COMM_FORMAT_STAND_I2S,
    .intr_alloc_flags = ESP_INTR_FLAG_LEVEL1,
    .dma_buf_count = 8,
    .dma_buf_len = 256,
    .use_apll = false,
    .tx_desc_auto_clear = true,
    .fixed_mclk = 0
  };
  i2s_pin_config_t pins = {
    .mck_io_num = I2S_PIN_NO_CHANGE,
    .bck_io_num = I2S_BCLK,
    .ws_io_num = I2S_LRC,
    .data_out_num = I2S_DOUT,
    .data_in_num = I2S_PIN_NO_CHANGE
  };
  i2s_driver_install(I2S_NUM_0, &cfg, 0, NULL);
  i2s_set_pin(I2S_NUM_0, &pins);
  i2s_zero_dma_buffer(I2S_NUM_0);

  for (;;) {
    generateAndWrite();
    // Let core 0's idle task run even when DSP leaves no DMA wait time.
    vTaskDelay(1);
  }
}

// ---- Touchpad drum trigger ----
void triggerPadHit(int tr) {
  switch (tr) {
    case 0:  // kick
      kickEnv = 1.0f; kickPitch = 1.0f; kickClickEnv = 0.50f;
      kickSnapEnv = 0.80f; kickSnapPhase = 0; scEnv = 0.0f;
      switch (soundVariant[0]) {
        case 0: kickSnapF=200; kBaseF=50; kSweepF=210; kAmpD=decayC(0.34f); kPitchD=decayC(0.038f); kickBodyEnv=0.65f; kickBodyPhase=0; kBodyD=decayC(0.022f); break;
        case 1: kickSnapF=310; kBaseF=55; kSweepF=290; kAmpD=decayC(0.15f); kPitchD=decayC(0.018f); kickBodyEnv=0.90f; kickBodyPhase=0; kBodyD=decayC(0.013f); break;
        case 2: kickSnapF=145; kBaseF=38; kSweepF=115; kAmpD=decayC(0.50f); kPitchD=decayC(0.060f); kickBodyEnv=0.40f; kickBodyPhase=0; kBodyD=decayC(0.030f); break;
        case 3: kickSnapF=390; kBaseF=62; kSweepF=370; kAmpD=decayC(0.09f); kPitchD=decayC(0.012f); kickBodyEnv=0.72f; kickBodyPhase=0; kBodyD=decayC(0.010f); break;
        default:kickSnapF=520; kBaseF=78; kSweepF=520; kAmpD=decayC(0.05f); kPitchD=decayC(0.008f); kickBodyEnv=0.28f; kickBodyPhase=0; kBodyD=decayC(0.008f); break;
      } break;
    case 1:  // snare
      snareEnv = 1.0f; snClickEnv = 0.68f; snPitch = 1.0f;
      switch (soundVariant[1]) {
        case 0: snToneF=185; snNoiseMix=0.78f; snD=decayC(0.10f);  snPitchD=decayC(0.012f); snWireEnv=0.60f; break;
        case 1: snToneF=390; snNoiseMix=0.10f; snD=decayC(0.038f); snPitchD=decayC(0.008f); snWireEnv=0;     break;
        case 2: snToneF=155; snNoiseMix=0.58f; snD=decayC(0.16f);  snPitchD=decayC(0.020f); snWireEnv=0.50f; break;
        case 3: snToneF=265; snNoiseMix=0.90f; snD=decayC(0.050f); snPitchD=decayC(0.006f); snWireEnv=0.32f; break;
        default:snToneF=222; snNoiseMix=0.72f; snD=decayC(0.070f); snPitchD=decayC(0.010f); snWireEnv=0.44f; break;
      } break;
    case 2:  // hihat
      prepareHatChoke();
      hatEnv = 1.0f; hatClickEnv = 0.55f;
      for (int hk = 0; hk < 6; hk++) hatPhase[hk] = 0;
      switch (soundVariant[2]) {
        case 0: hatD=decayC(0.016f); hatBaseF=1520.0f; rideBellEnv=0; break;
        case 1: hatD=decayC(0.20f);  hatBaseF=1080.0f; rideBellEnv=0; break;
        case 2: hatD=decayC(0.010f); hatBaseF=1750.0f; rideBellEnv=0; break;
        default:hatD=decayC(0.45f);  hatBaseF=820.0f;  rideBellEnv=0.75f; rideBellPhase=0; break;
      } break;
    case 3:  // clap
      clapEnv = 1.0f; clapEnv2 = 0; clapEnv3 = 0;
      switch (soundVariant[3]) {
        case 0: clapD=decayC(0.065f); clapCnt2=330; clapCnt3=730; break;
        case 1: clapD=decayC(0.040f); clapCnt2=0;   clapCnt3=0;   break;
        case 2: clapD=decayC(0.10f);  clapCnt2=200; clapCnt3=0;   break;
        default:clapD=decayC(0.022f); clapCnt2=0;   clapCnt3=0;   break;
      } break;
    case 4:  // tom
      tomEnv = 1.0f; tomPitch = 1.0f; tomClickEnv = 0.45f; tomRingEnv = 0.52f; tomRingPhase = 0;
      switch (soundVariant[4]) {
        case 0: tBaseF=100; tSweepF=130; tAmpD=decayC(0.22f); tPitchD=decayC(0.08f); break;
        case 1: tBaseF=130; tSweepF=150; tAmpD=decayC(0.19f); tPitchD=decayC(0.07f); break;
        case 2: tBaseF=160; tSweepF=180; tAmpD=decayC(0.16f); tPitchD=decayC(0.06f); break;
        default:tBaseF=80;  tSweepF=110; tAmpD=decayC(0.28f); tPitchD=decayC(0.10f); break;
      } break;
  }
  if (tr >= 0 && tr < 5) finishVoiceTrigger(tr, -1);
}

// ---- Pot → volume (smoothed 20Hz poll, 0-10) ----
void handlePot() {
  static unsigned long lastPot = 0;
  if (millis() - lastPot < 50) return;
  lastPot = millis();
  int raw = analogRead(POT_PIN);
  static int menuPotAnchor = -1;
  if (menuPotAnchor < 0) menuPotAnchor = raw;
  if (abs(raw - menuPotAnchor) >= 64) {
    menuPotAnchor = raw;
    menuInteraction();
  }
  static int smooth = -1; if (smooth < 0) smooth = raw;
  smooth = smooth + (raw - smooth) / 4;  // simple IIR, no cold-start zero
  if (mode == MODE_DENSITY) {
    float d = (float)smooth / 4095.0f;
    if (smooth <= 8) d = 0; else if (smooth >= 4087) d = 1;
    if (fabsf(d - densityScale) >= 0.005f || (d != densityScale && (d == 0 || d == 1))) {
      densityScale = d;
      markDirty();
    }
    return;
  }
  if (mode == MODE_COMP) {
    float threshold = 0.2f + (float)smooth / 4095.0f * 0.7f;
    if (fabsf(threshold - compThr) >= 0.005f) {
      compThr = threshold;
      markDirty();
    }
    return;
  }
  if (mode == MODE_FX) {
    float amount = smooth / 4095.0f * 2.0f;
    if (fabsf(amount - masterVerbAmt) >= 0.005f) {
      masterVerbAmt = amount;
      if (morphTransient) morphVerb = masterVerbAmt;
      markDirty();
    }
    return;
  }
  if (mode == MODE_GLITCH) {
    float depth = smooth / 4095.0f;
    if (fabsf(depth - glitchDepth) >= 0.005f) {
      glitchDepth = depth;
      markDirty();
    }
    return;
  }
  if (mode == MODE_MIX) {
    int tr = cursor / STEPS;
    float gain = (float)smooth / 4095.0f;
    if (fabsf(gain - gTrack[tr]) >= 0.005f) {
      gTrack[tr] = gain;
      if (morphTransient) morphGain[tr] = gain;
      markDirty();
    }
    return;
  }
  if (mode == MODE_NUDGE || mode == MODE_VOICE) return;
  if (mode == MODE_DUCK) {
    float depth = (float)smooth / 4095.0f;
    if (fabsf(depth - sidechainDepth) >= 0.005f) {
      sidechainDepth = depth;
      markDirty();
    }
    return;
  }
  int v = smooth * 10 / 4095;
  if (v != volume) {
    volume = v;
    Serial.printf("POT raw=%d smooth=%d vol=%d\n", raw, smooth, v);
    markDirty();
  }
}

// Hardware-debounced active-LOW button. Always a different drum from P3.
void handleDrumButton() {
  static bool last = HIGH, bankPress = false, heldHandled = false, copyEligible = false;
  static bool tapPending = false;
  static uint32_t pressDownMs = 0, lastTapMs = 0;
  static int tapRow = -1;
  uint32_t now = millis();
  bool raw = digitalRead(DRUM_BUTTON);
  if (raw == LOW && last == HIGH) {
    pressDownMs=now; heldHandled=false; bankPress=(mode==MODE_BANK);
    copyEligible=(mode==MODE_EDIT && !encHeldNow);
    if (bankPress) {
      copyLiveToBank(bankSel); markDirty();
      Serial.printf("COPY → BANK %c\n",'A'+bankSel);
    } else if (mode==MODE_REC) {
      recordLiveHit();
    } else if (digitalRead(ENC2_BTN)==HIGH) {
      pattern[1][currentStep]=1; markDirty();
      Serial.printf("RECORD snare step=%d\n",currentStep+1);
    } else {
      int tr=(padDrumSel+1)%5;
      if(!muted[tr]) triggerPadHit(tr);
    }
  }
  if (raw==LOW && !bankPress && mode!=MODE_BANK && !heldHandled && now-pressDownMs>=500) {
    heldHandled=true; tapPending=false;
    if (!fillActive && !fillRequested) {
      fillTrack=padDrumSel; fillStartMs=now; fillActive=true;
      fillRequested=true; // audio clock starts the complete roll at the next bar
      Serial.printf("FILL queued track=%d\n",(int)fillTrack);
    }
  }
  if(raw==HIGH && last==LOW) {
    if(copyEligible && mode==MODE_EDIT && !encHeldNow && !heldHandled && now-pressDownMs<300) {
      int tr=cursor/STEPS;
      if(tapPending && tapRow==tr && now-lastTapMs<=300) {
        copyPasteSelectedTrack(); tapPending=false;
      } else { tapPending=true; tapRow=tr; lastTapMs=now; }
    } else tapPending=false;
  }
  bool led;
  if (fillActive && fillStepsLeft > 0) {
    led = (uint32_t)(now - fillFlashMs) < 30;
  } else if (raw == LOW) {
    led = true;
  } else {
    uint32_t stepMs = 60000UL / bpm / 2;
    uint32_t downPulse = stepMs * 2 / 3;
    uint32_t offPulse = stepMs / 4;
    led = (uint32_t)(now - lastDownbeatMs) < downPulse ||
          (uint32_t)(now - lastStepMs) < offPulse;
  }
  if(recordFlashMs && now-recordFlashMs<40) led=true;
  digitalWrite(DRUM_LED,led ? HIGH : LOW);
  last=raw;
}

// ---- Touchpad → fire the selected drum hit on touch-down ----
void handleTouchpad() {
  static bool lastTouch = false;
  static unsigned long lastHit = 0;
  bool touch = digitalRead(TOUCH_PIN) == HIGH;
  if (touch && !lastTouch && millis() - lastHit > 40) {
    if (mode == MODE_REC) {
      recordLiveHit();
    } else if (digitalRead(ENC2_BTN) == HIGH) {
      int st = currentStep;
      pattern[0][st] = 1;
      markDirty();
      Serial.printf("RECORD kick step=%d\n", st + 1);
    } else {
      if (!muted[padDrumSel]) triggerPadHit(padDrumSel);
    }
    lastHit = millis();
  }
  lastTouch = touch;
}

// ---- Encoder 2 → rotate: adjust BPM. short press: mute track in EDIT, otherwise next mode. long press: home to EDIT ----
void handleEncoder2() {
  long pos = encoder2.getPosition();
  long delta = pos - lastEncPos2;
  delta = -delta;
  if (delta != 0) {
    menuInteraction();
    if (mode == MODE_PRESET && digitalRead(ENC_BTN) == HIGH) {
      changeMorph((int)delta);
    } else if (mode == MODE_CHAIN) {
      uint16_t &number = arrangements[arrangementOwner].chain[chainEdit];
      number = constrain((int)number + (int)delta, 0, presetCount);
    } else if (mode == MODE_SONG) {
      SongSlot &slot = arrangements[arrangementOwner].song[songEdit];
      if (songRepeatEdit) slot.repeats = constrain((int)slot.repeats + (int)delta, 1, 16);
      else slot.preset = constrain((int)slot.preset + (int)delta, 0, presetCount);
    } else if (mode == MODE_NUDGE) {
      int tr = cursor / STEPS;
      trackNudge[tr] = constrain((int)trackNudge[tr] + (int)delta, -8, 8);
    } else if (mode == MODE_VOICE) {
      int tr = cursor / STEPS;
      if (voicePitchEdit) trackPitchOffset[tr] = constrain((int)trackPitchOffset[tr] + (int)delta, -24, 24);
      else trackDecayScale[tr] = constrain(trackDecayScale[tr] + delta * 0.1f, 0.2f, 3.0f);
    } else if (mode == MODE_HUMAN) {
      int tr = cursor / STEPS;
      humanize[tr] = constrain((int)humanize[tr] + (int)delta, 0, 9);
      Serial.printf("HUMAN track=%d amount=%d\n", tr, humanize[tr]);
    } else setBPM(bpm + (int)delta);
    lastEncPos2 = pos;
    Serial.printf("BPM=%d\n", bpm);
    markDirty();
  }
  static bool last2 = LOW;
  static unsigned long pressTime2 = 0;
  static bool handled2 = true;
  bool btn = digitalRead(ENC2_BTN);  // pull-down: HIGH=pressed, LOW=released
  if (btn == HIGH && last2 == LOW) { pressTime2 = millis(); handled2 = false; Serial.println("ENC2 DOWN"); }
  if (btn == HIGH && !handled2 && mode == MODE_REC && millis() - pressTime2 >= 1000) {
    int tr=cursor/STEPS;
    memset(pattern[tr],0,sizeof(pattern[tr]));
    markDirty(); handled2=true; Serial.printf("REC CLEAR ROW %d\n",tr);
  }
  if (btn == LOW && last2 == HIGH && !handled2) {
    unsigned long held = millis() - pressTime2;
    handled2 = true;
    menuHintVisible = false;
    Serial.printf("ENC2 UP held=%lums\n", held);
    if (held >= 1500 && mode == MODE_SONG) {
      songRepeatEdit = !songRepeatEdit;
      Serial.printf("SONG edit %s\n", songRepeatEdit ? "REPEATS" : "PRESET");
    } else if (held >= 1500) {
      mode = MODE_EDIT; secondaryTier = false; cursor = 0; Serial.println("ENC2 long→EDIT");
    } else if (held > 20) {
      if (mode == MODE_EDIT && digitalRead(ENC_BTN) == HIGH) {
        int tr = cursor / STEPS, st = cursor % STEPS;
        ratchet[tr][st] = (ratchet[tr][st] + 1) % 4;
        encChordConsumed = true;
        markDirty();
        Serial.printf("RATCHET track=%d step=%d hits=%d\n", tr, st + 1, ratchet[tr][st] + 1);
      } else if (mode == MODE_EDIT) {
        int tr = cursor / STEPS;
        muted[tr] = !muted[tr];
        markDirty();
        Serial.printf("ENC2 MUTE track %d → %s\n", tr, muted[tr] ? "muted" : "unmuted");
      } else {
        advanceMode(1500);
        Serial.printf("ENC2 short→NEXT MODE %d\n", (int)mode);
      }
    }
  }
  last2 = btn;
}

void handleEncoder() {
  long pos = encoder.getPosition();
  long delta = pos - lastEncPos;
  delta = -delta;
  if (delta != 0) {
    menuInteraction();
    Serial.printf("ENC1 delta=%ld mode=%d cursor=%d\n", delta, (int)mode, cursor);
    if (mode == MODE_CHAIN) {
      chainEdit = constrain(chainEdit + (int)delta, 0, 7);
    } else if (mode == MODE_SONG) {
      songEdit = constrain(songEdit + (int)delta, 0, 15);
    } else if (mode == MODE_TEMPO) {
      setBPM(bpm + (int)delta);            // rotate = adjust BPM (40..240) in TEMPO mode
      markDirty();
    } else if (mode == MODE_SWING) {
      int v = swing + (int)delta;          // rotate = set swing amount (0..9)
      swing = v < 0 ? 0 : (v > 9 ? 9 : v);
      markDirty();
    } else if (mode == MODE_MUTE) {
      muteSel = ((muteSel + (int)delta) % TRACKS + TRACKS) % TRACKS;
    } else if (mode == MODE_MIX || mode == MODE_HUMAN || mode == MODE_NUDGE || mode == MODE_VOICE || mode == MODE_REC) {
      int tr = ((cursor / STEPS + (int)delta) % TRACKS + TRACKS) % TRACKS;
      cursor = tr * STEPS;
    } else if (mode == MODE_NOTE) {
      int v = synthNote[noteSynth][noteStep] + (int)delta;   // rotate = set this synth step's pitch
      synthNote[noteSynth][noteStep] = v < -24 ? -24 : (v > 24 ? 24 : v);
      markDirty();
    } else if (mode == MODE_SOUND) {
      int r = cursor / STEPS;              // rotate = cycle the selected track's sound
      int n = variantCount[r];
      soundVariant[r] = ((soundVariant[r] + (int)delta) % n + n) % n;
      markDirty();
    } else if (mode == MODE_FX) {
      int r = cursor / STEPS;              // rotate = cycle the selected track's effect
      trackFX[r] = ((trackFX[r] + (int)delta) % FXCOUNT + FXCOUNT) % FXCOUNT;
      markDirty();
    } else if (mode == MODE_GLITCH) {
      globalFX = ((globalFX + (int)delta) % GFXCOUNT + GFXCOUNT) % GFXCOUNT;  // rotate = pick the global effect
      markDirty();
    } else if (mode == MODE_KIT) {
      int n = kitCount;                    // rotate = browse drum kits
      kitSel = ((kitSel + (int)delta) % n + n) % n;
    } else if (mode == MODE_BANK) {
      int n = BANKS;                       // rotate = pick the bank to recall
      bankSel = ((bankSel + (int)delta) % n + n) % n;
    } else if (mode == MODE_PRESET) {
      int n = presetCount;                 // rotate = browse preset sequences
      presetSel = ((presetSel + (int)delta) % n + n) % n;
    } else if (mode == MODE_BRIGHT) {
      int v = matBright + (int)delta;      // rotate = set matrix brightness (live, 0 = off)
      matBright = v < 0 ? 0 : (v > 60 ? 60 : v);
          markDirty();
    } else if (mode == MODE_LED) {
      ledStyle = ((ledStyle + (int)delta) % LEDCOUNT + LEDCOUNT) % LEDCOUNT;  // rotate = live matrix animation
      markDirty();
    } else if (mode == MODE_CHANCE) {
      int r = cursor / STEPS, c = cursor % STEPS;   // rotate = set this cell's trigger probability
      int v = chance[r][c] + (int)delta * 5;
      chance[r][c] = v < 0 ? 0 : (v > 100 ? 100 : v);
      markDirty();
    } else if (mode == MODE_GLIDE) {
      int v = glideAmt + (int)delta;       // rotate = set portamento glide (0=snap, 9=slow)
      glideAmt = v < 0 ? 0 : (v > 9 ? 9 : v);
      markDirty();
    } else if (mode == MODE_TRANSPOSE) {
      int v = transposeAmt + (int)delta;   // rotate = shift both synths into any key (±24 semitones)
      transposeAmt = v < -24 ? -24 : (v > 24 ? 24 : v);
      markDirty();
    } else {
      if (mode == MODE_EDIT && encHeldNow) {
        int st = cursor % STEPS;
        int v = stepMicro[st] + (int)delta;
        stepMicro[st] = v < -9 ? -9 : (v > 9 ? 9 : v);
        encChordConsumed = true; // adjusting timing must not toggle the cell on release
        markDirty();
      } else {
        int total = TRACKS * STEPS;          // rotate = move the cursor across the grid
        cursor = ((cursor + (int)delta) % total + total) % total;
      }
    }
    lastEncPos = pos;
  }
}

// ---- doSelectAction: the confirm/action for whatever mode is active ----
void doSelectAction() {
  menuInteraction();
  Serial.printf("SELECT mode=%d\n", (int)mode);
  if (mode == MODE_VOICE) {
    voicePitchEdit = !voicePitchEdit;
  } else if (mode == MODE_CHOKE) {
    chokeHatOnClosed = !chokeHatOnClosed;
    markDirty();
    Serial.printf("CHOKE %s\n", chokeHatOnClosed ? "ON" : "OFF");
  } else if (mode == MODE_METRO) {
    metronome = !metronome;
    markDirty();
    Serial.printf("METRO %s\n", metronome ? "ON" : "OFF");
  } else if (mode == MODE_EDIT) {
    int r = cursor / STEPS, c = cursor % STEPS;
    pattern[r][c] = (pattern[r][c] + 1) % 3;  markDirty();
  } else if (mode == MODE_MUTE) {
    muted[muteSel] = !muted[muteSel];  Serial.printf("MUTE track %d → %s\n", muteSel, muted[muteSel] ? "muted" : "unmuted");  markDirty();
  } else if (mode == MODE_CHANCE) {
    cursor = (cursor + 1) % (TRACKS * STEPS);
  } else if (mode == MODE_NOTE) {
    noteStep++;  if (noteStep >= STEPS) { noteStep = 0; noteSynth ^= 1; }
  } else if (mode == MODE_SOUND || mode == MODE_FX) {
    int r = (cursor / STEPS + 1) % TRACKS;  cursor = r * STEPS;
  } else if (mode == MODE_KIT) {
    loadKit(kitSel);  markDirty();
  } else if (mode == MODE_BANK) {
    saveBankFromLive();  loadBankToLive(bankSel);  markDirty();
  } else if (mode == MODE_BANK_SONG) {
    songMode = !songMode;
  } else if (mode == MODE_CHAIN) {
    toggleChain();
  } else if (mode == MODE_SONG) {
    togglePresetSong();
  } else if (mode == MODE_PRESET) {
    loadPreset(presetSel);  markDirty();
  } else if (mode == MODE_TEMPO) {
    unsigned long tnow = millis();
    if (tapCount > 0 && tnow - tapTimes[(tapCount-1)%4] > 2000) tapCount = 0;
    tapTimes[tapCount % 4] = tnow;  tapCount++;
    if (tapCount >= 2) {
      int spans = tapCount-1 < 3 ? tapCount-1 : 3;
      unsigned long first = tapTimes[(tapCount-1-spans)%4];
      unsigned long last  = tapTimes[(tapCount-1)%4];
      float pb = (float)(last-first)/spans;
      if (pb > 100) { setBPM((int)(60000.0f/pb+0.5f)); markDirty(); }
    }
  }
}

// ---- Encoder 1 button: short press = SELECT (confirm action), long press (1.5s) = cycle to next mode ----
void handleButton() {
  static uint32_t lastReleaseMs = 0;
  static int lastTapCursor = -1;
  static bool tapPending = false;
  bool btn = digitalRead(ENC_BTN);  // pull-down: HIGH=pressed, LOW=released
  if (btn == HIGH && lastBtnState == LOW) {
    btnPressTime = millis();  btnHandled = false;  btn4sHandled = false;
    encChordConsumed = false;
    Serial.println("ENC1 DOWN");
  }
  if (btn == LOW && lastBtnState == HIGH && !btnHandled) {
    unsigned long held = millis() - btnPressTime;
    btnHandled = true;
    Serial.printf("ENC1 UP held=%lums mode=%d\n", held, (int)mode);
    if (morphActive) finishMorph();
    if (encChordConsumed) {
      tapPending = false; // ratchet chord consumes only this ENC1 release
    } else if (held >= 1500) {
      // long press: cycle to next mode
      tapPending = false;
      advanceMode(held);
      Serial.printf("ENC1 long→NEXT MODE %d\n", (int)mode);
    } else if (held >= 700 && mode == MODE_FX) {
      int tr=cursor/STEPS;
      reverseAccent[tr]=!reverseAccent[tr];
      markDirty(); tapPending=false;
      Serial.printf("REVERSE track=%d %s\n",tr,reverseAccent[tr] ? "ON" : "OFF");
    } else if (held > 20) {
      uint32_t released = millis();
      if (mode == MODE_EDIT && tapPending && cursor == lastTapCursor && released - lastReleaseMs <= 400) {
        int r = cursor / STEPS;
        memset(pattern[r], 0, sizeof(pattern[r]));
        memset(chance[r], 100, sizeof(chance[r]));
        markDirty();
        Serial.printf("CLEAR ROW %d\n", r);
        tapPending = false;
      } else {
        doSelectAction();
        Serial.println("ENC1 short→SELECT done");
        tapPending = (mode == MODE_EDIT);
      }
      lastReleaseMs = released;
      lastTapCursor = cursor;
    }
  }
  lastBtnState = btn;
  encHeldNow = (digitalRead(ENC_BTN) == HIGH);
}

void clearPx() { for (int i = 0; i < 25; i++) { px_r[i] = px_g[i] = px_b[i] = 0; } }

// 20 selectable matrix animations (MODE_LED). Each writes the paint buffer
// (px_r/g/b), then a single loop fades + renders. Trail styles paint on the
// beat and use fade < 1; full-redraw styles clearPx() and use fade = 1.
void updateMatrix() {
  static const uint8_t PR[5] = {  80,  60, 190, 140,  40 };  // palette (light-blue,
  static const uint8_t PG[5] = { 200, 220, 130,  40, 150 };  // green, light-purple,
  static const uint8_t PB[5] = { 255,  90, 240, 200, 255 };  // purple, blue)
  static const uint8_t trkPal[7] = { 0, 1, 2, 4, 3, 3, 2 };  // K S H C T B b -> palette
  static uint32_t frame = 0;
  static float pulse = 0, ringR = 9, ripR = 9;
  frame++;

  // Live audio energy read straight off the voice envelopes (written by the
  // audio task). It drives every animation's MOTION and BRIGHTNESS, so all 20
  // styles react to the actual sound instead of a fixed frame clock: motion
  // speeds up on busy passages, the whole grid brightens on hits and dims in
  // the gaps. `level` is smoothed (fast attack, slow release) so it pumps with
  // the music without strobing; `motion` is the beat-reactive replacement for
  // the old raw frame counter.
  float energy = kickEnv + 0.7f * snareEnv + 0.6f * tomEnv
               + 0.5f * (hatEnv + clapEnv) + 0.6f * (synthEnv[0] + synthEnv[1]);
  if (energy > 1.0f) energy = 1.0f;
  static float level = 0;
  level += (energy > level ? 0.5f : 0.08f) * (energy - level);
  static float motion = 0;
  motion += 0.12f + energy * 1.1f;      // animation motion tracks the music's intensity
  uint32_t mo = (uint32_t)motion;

  int step = currentStep;
  bool newStep = (step != lastSeenStep);
  if (newStep) { lastSeenStep = step; pulse = 1.0f; ringR = 0; ripR = 0; }
  pulse *= 0.82f;
  ringR += 0.55f;
  ripR  += 0.5f;

  // primary color: first active drum on this step, else the palette rotated by step
  int prim = -1;
  for (int r = 0; r < TRACKS; r++) if (pattern[r][step]) { prim = r; break; }
  uint8_t cr, cg, cb;
  { int p = (prim >= 0) ? trkPal[prim] : (step % 5); cr = PR[p]; cg = PG[p]; cb = PB[p]; }

  float fade = 0.80f;
  switch (ledStyle) {
    case 0:  // PAINT — each drum stamps its own shape
      if (newStep) {
        if (pattern[5][step]) for (int i = 0; i < 5; i++) paint(i * 5 + i, 140, 40, 200);
        if (pattern[6][step]) for (int i = 0; i < 5; i++) paint(i * 5 + (4 - i), 120, 90, 255);
        if (pattern[4][step]) for (int r = 0; r < 5; r++) paint(r * 5 + 2, 40, 150, 255);
        if (pattern[1][step]) for (int c = 0; c < 5; c++) paint(2 * 5 + c, 60, 220, 90);
        if (pattern[2][step]) for (int n = 0; n < 5; n++) paint(random(25), 190, 130, 240);
        if (pattern[3][step]) for (int n = 0; n < 4; n++) paint(random(25), 40, 150, 255);
        if (pattern[0][step]) for (int i = 0; i < 25; i++) paint(i, 80, 200, 255);
      }
      break;
    case 1: {  // BARS — VU columns that jump on the beat and fall
      clearPx(); fade = 1.0f;
      float amp = pulse > level ? pulse : level;   // VU height tracks live audio level
      int h = (int)(amp * 5.99f);
      for (int c = 0; c < 5; c++)
        for (int k = 0; k <= h && k < 5; k++) paint((4 - k) * 5 + c, PR[c], PG[c], PB[c]);
      break;
    }
    case 2:  // SPARKLE — random sparks on each hit
      if (newStep) for (int n = 0; n < 6; n++) paint(random(25), cr, cg, cb);
      fade = 0.74f;
      break;
    case 3: {  // RINGS — ring expands from the center each step
      clearPx(); fade = 1.0f;
      for (int i = 0; i < 25; i++) {
        float dr = i / 5 - 2, dc = i % 5 - 2, d = sqrtf(dr * dr + dc * dc);
        if (fabsf(d - ringR) < 0.7f) paint(i, cr, cg, cb);
      }
      break;
    }
    case 4: {  // CHASE — dot runs the perimeter with a trail
      static const int perim[16] = { 0,1,2,3,4,9,14,19,24,23,22,21,20,15,10,5 };
      paint(perim[mo % 16], cr, cg, cb);
      fade = 0.60f;
      break;
    }
    case 5: {  // RAIN — pixels fall from the top, seeded on the beat
      if (frame % 2 == 0) {
        for (int r = 4; r >= 1; r--)
          for (int c = 0; c < 5; c++) {
            int d = r * 5 + c, s = (r - 1) * 5 + c;
            px_r[d] = px_r[s]; px_g[d] = px_g[s]; px_b[d] = px_b[s];
          }
        for (int c = 0; c < 5; c++) { px_r[c] = px_g[c] = px_b[c] = 0; }
      }
      if (newStep) { int c = random(5); px_r[c] = cr; px_g[c] = cg; px_b[c] = cb; }
      fade = 0.92f;
      break;
    }
    case 6:  // PULSE — whole grid flashes on the beat
      if (newStep) for (int i = 0; i < 25; i++) paint(i, cr, cg, cb);
      fade = 0.80f;
      break;
    case 7: {  // HSCAN — a column sweeps left to right
      int col = mo % 5;
      for (int r = 0; r < 5; r++) paint(r * 5 + col, cr, cg, cb);
      fade = 0.50f;
      break;
    }
    case 8: {  // VSCAN — a row sweeps top to bottom
      int row = mo % 5;
      for (int c = 0; c < 5; c++) paint(row * 5 + c, cr, cg, cb);
      fade = 0.50f;
      break;
    }
    case 9: {  // IMPLODE — ring collapses inward each step
      clearPx(); fade = 1.0f;
      float ir = 3.0f - ringR; if (ir < 0) ir = 0;
      for (int i = 0; i < 25; i++) {
        float dr = i / 5 - 2, dc = i % 5 - 2, d = sqrtf(dr * dr + dc * dc);
        if (fabsf(d - ir) < 0.7f) paint(i, cr, cg, cb);
      }
      break;
    }
    case 10: {  // CHECKER — checkerboard flips each step
      clearPx(); fade = 1.0f;
      int ph = step % 2;
      for (int i = 0; i < 25; i++)
        if (((i / 5) + (i % 5)) % 2 == ph) paint(i, cr, cg, cb);
      break;
    }
    case 11: {  // FLICKER — whole grid shimmers in the hit color
      clearPx(); fade = 1.0f;
      for (int i = 0; i < 25; i++) {
        float f = 0.25f + 0.75f * (random(100) / 100.0f);
        paint(i, cr * f, cg * f, cb * f);
      }
      break;
    }
    case 12: {  // WAVE — a sine wave rolls across the columns
      clearPx(); fade = 1.0f;
      float ph = motion * 0.20f;
      for (int c = 0; c < 5; c++) {
        int row = (int)(2.0f + 1.8f * sinf(ph + c * 0.9f) + 0.5f);
        if (row < 0) row = 0; if (row > 4) row = 4;
        paint(row * 5 + c, cr, cg, cb);
      }
      break;
    }
    case 13: {  // SPIRAL — fills along a spiral, then resets
      static const int spiral[25] = { 12,7,8,13,18,17,16,11,6,1,2,3,4,9,14,19,24,23,22,21,20,15,10,5,0 };
      clearPx(); fade = 1.0f;
      int n = mo % 26;
      for (int k = 0; k < n && k < 25; k++) paint(spiral[k], cr, cg, cb);
      break;
    }
    case 14: {  // DIAG — a diagonal line sweeps across with a trail
      int d0 = mo % 9;
      for (int i = 0; i < 25; i++)
        if ((i / 5) + (i % 5) == d0) paint(i, cr, cg, cb);
      fade = 0.60f;
      break;
    }
    case 15:  // CORNERS — each drum lights its own quadrant
      if (newStep) {
        if (pattern[0][step]) { int q[4]={0,1,5,6};    for(int j=0;j<4;j++) paint(q[j], PR[0], PG[0], PB[0]); }
        if (pattern[1][step]) { int q[4]={3,4,8,9};    for(int j=0;j<4;j++) paint(q[j], PR[1], PG[1], PB[1]); }
        if (pattern[2][step]) { int q[4]={15,16,20,21};for(int j=0;j<4;j++) paint(q[j], PR[2], PG[2], PB[2]); }
        if (pattern[3][step]) { int q[4]={18,19,23,24};for(int j=0;j<4;j++) paint(q[j], PR[4], PG[4], PB[4]); }
        if (pattern[4][step] || pattern[5][step]) paint(12, PR[3], PG[3], PB[3]);
      }
      fade = 0.82f;
      break;
    case 16:  // STROBE — a sharp full-grid strobe on the beat
      clearPx(); fade = 1.0f;
      if (pulse > 0.55f) for (int i = 0; i < 25; i++) paint(i, cr, cg, cb);
      break;
    case 17: {  // RIPPLE — expanding ring with a fading wake
      for (int i = 0; i < 25; i++) {
        float dr = i / 5 - 2, dc = i % 5 - 2, d = sqrtf(dr * dr + dc * dc);
        if (fabsf(d - ripR) < 0.9f) paint(i, cr, cg, cb);
      }
      fade = 0.70f;
      break;
    }
    case 18: {  // FILL — scatters in over the step, then clears
      clearPx(); fade = 1.0f;
      int n = (int)((1.0f - pulse) * 25);
      for (int k = 0; k < n; k++) paint((k * 7) % 25, cr, cg, cb);
      break;
    }
    default: {  // TWINKLE — gentle drifting stars across the palette
      for (int n = 0; n < 2; n++) { int p = random(5); paint(random(25), PR[p], PG[p], PB[p]); }
      fade = 0.85f;
      break;
    }
  }

  // master brightness pumps with the live audio level, so even the motion-only
  // styles visibly breathe with the music (floor keeps some presence in gaps).
  float bright = 0.30f + 0.70f * level;
  for (int i = 0; i < 25; i++) {
    px_r[i] *= fade; px_g[i] *= fade; px_b[i] *= fade;
    float rr = px_r[i] * bright, gg = px_g[i] * bright, bb = px_b[i] * bright;
    uint8_t r = rr > 255 ? 255 : (uint8_t)rr;
    uint8_t g = gg > 255 ? 255 : (uint8_t)gg;
    uint8_t b = bb > 255 ? 255 : (uint8_t)bb;
    (void)r; (void)g; (void)b;  // matrix removed — updateMatrix() is dead code
  }
}

#include "menu_help.h"

void drawUI() {
  const uint16_t BLACK = C(0, 0, 0);
  const uint16_t WHITE = C(255, 255, 255);
  const uint16_t GRAY  = C(70, 70, 70);
  const uint16_t HILITE = C(45, 45, 55);
  uint16_t rowCol[7] = {
    C(80, 200, 255), C(60, 220, 90),  C(190, 130, 240),
    C(40, 150, 255), C(140, 40, 200), C(190, 130, 240), C(120, 90, 255)
  };
  const char* rowLbl[7] = { "K", "S", "H", "C", "T", "B", "b" };

  const int startX = 16, colW = 18, cellW = 15, cellH = 8;
  const int rowY[7] = { 15, 24, 32, 40, 48, 56, 64 };
  const uint32_t uiNow = millis();

  canvas.fillScreen(BLACK);

  canvas.setTextSize(1);
  canvas.setTextColor(WHITE);
  canvas.setTextWrap(false);
  // One tag builder and one renderer; MODE_VOLUME aliases MODE_MUTE.
  char tag[40] = {};
  const int tr = cursor / STEPS;
  const Arrangement &a = arrangements[arrangementOwner];
  switch (mode) {
    case MODE_EDIT:
      snprintf(tag, sizeof(tag), "%s", lastPreset >= 0 ? presets[lastPreset].name : "EDIT"); break;
    case MODE_MUTE: snprintf(tag,sizeof(tag),"MUTE %s:%s",rowLbl[muteSel],muted[muteSel] ? "MUTED" : "ON"); break;
    case MODE_MIX: snprintf(tag,sizeof(tag),"MIX:%s %.2f",rowLbl[tr],gTrack[tr]); break;
    case MODE_NUDGE: snprintf(tag,sizeof(tag),"NUDGE:%s %+d",rowLbl[tr],trackNudge[tr]); break;
    case MODE_DUCK: snprintf(tag,sizeof(tag),"DUCK:%d%%",(int)roundf(sidechainDepth*100)); break;
    case MODE_SOUND: snprintf(tag,sizeof(tag),"%s:%s",tr>=5 ? synthCat(soundVariant[tr]) : rowLbl[tr],soundName(tr,soundVariant[tr])); break;
    case MODE_FX: snprintf(tag,sizeof(tag),"%s:%s%s",rowLbl[tr],fxName(trackFX[tr]),reverseAccent[tr] ? " REV" : ""); break;
    case MODE_GLITCH: snprintf(tag,sizeof(tag),"GLITCH:%s",gfxName(globalFX)); break;
    case MODE_NOTE: snprintf(tag,sizeof(tag),"B%d NOTE%d:%+d",noteSynth+1,noteStep+1,synthNote[noteSynth][noteStep]); break;
    case MODE_BRIGHT:
      if (matBright) snprintf(tag,sizeof(tag),"BRIGHT:%d",matBright);
      else snprintf(tag,sizeof(tag),"BRIGHT:OFF"); break;
    case MODE_LED: snprintf(tag,sizeof(tag),"LED:%s",ledName(ledStyle)); break;
    case MODE_PRESET: snprintf(tag,sizeof(tag),"P%02d:%s",presetSel+1,presets[presetSel].name); break;
    case MODE_KIT: snprintf(tag,sizeof(tag),"KIT:%s",kits[kitSel].name); break;
    case MODE_BANK: snprintf(tag,sizeof(tag),"BANK %c>%c",'A'+curBank,'A'+bankSel); break;
    case MODE_BANK_SONG: snprintf(tag,sizeof(tag),"BANK SONG:%s %c",songMode ? "ON" : "OFF",'A'+curBank); break;
    case MODE_SWING: snprintf(tag,sizeof(tag),"SWING:%d",swing); break;
    case MODE_GLIDE:
      if (glideAmt) snprintf(tag,sizeof(tag),"GLIDE:%d",glideAmt);
      else snprintf(tag,sizeof(tag),"GLIDE:OFF"); break;
    case MODE_TRANSPOSE:
      if (transposeAmt) snprintf(tag,sizeof(tag),"KEY:%+d",transposeAmt);
      else snprintf(tag,sizeof(tag),"KEY:ROOT"); break;
    case MODE_CHANCE:
      if (chance[tr][cursor%STEPS]>=100) snprintf(tag,sizeof(tag),"CHANCE %s%d:ALWAYS",rowLbl[tr],cursor%STEPS+1);
      else snprintf(tag,sizeof(tag),"CHANCE %s%d:%d%%",rowLbl[tr],cursor%STEPS+1,chance[tr][cursor%STEPS]); break;
    case MODE_COMP: snprintf(tag,sizeof(tag),"COMP:%.2f",compThr); break;
    case MODE_CHOKE: snprintf(tag,sizeof(tag),"CHOKE %s",chokeHatOnClosed ? "ON" : "OFF"); break;
    case MODE_HUMAN: snprintf(tag,sizeof(tag),"HUMAN %s:%d",rowLbl[tr],humanize[tr]); break;
    case MODE_METRO: snprintf(tag,sizeof(tag),"METRO %s",metronome ? "ON" : "OFF"); break;
    case MODE_DENSITY: snprintf(tag,sizeof(tag),"DENSITY %d%%",(int)roundf(densityScale*100)); break;
    case MODE_CHAIN: snprintf(tag,sizeof(tag),"CH%d:P%03d %s",chainEdit+1,a.chain[chainEdit],chainPlay ? "ON" : "OFF"); break;
    case MODE_SONG: snprintf(tag,sizeof(tag),"S%02d:P%03d %c%02d",songEdit+1,a.song[songEdit].preset,songRepeatEdit ? '*' : 'x',a.song[songEdit].repeats); break;
    case MODE_VOICE:
      if (voicePitchEdit) snprintf(tag,sizeof(tag),"%s PITCH:%+d",rowLbl[tr],trackPitchOffset[tr]);
      else snprintf(tag,sizeof(tag),"%s DECAY:%.1f",rowLbl[tr],trackDecayScale[tr]); break;
    case MODE_TEMPO: snprintf(tag,sizeof(tag),"TAP"); break;
    case MODE_REC: snprintf(tag,sizeof(tag),"REC"); break;
    default: break;
  }
  const int boxX = 12, boxY = 1, boxW = canvas.width()-28, boxH = 12;
  canvas.fillRect(boxX, boxY, boxW, boxH, C(180,100,255));
  // EDIT/TEMPO reserve the left portion for their default-font BPM readout.
  bool showBpm = mode == MODE_EDIT || mode == MODE_TEMPO;
  int textX = showBpm ? 60 : boxX;
  int textW = boxX + boxW - textX;
  canvas.setFont(&FreeSansBold9pt7b);
  canvas.setTextSize(1);
  canvas.setTextColor(BLACK);
  int16_t bx, by;
  uint16_t bw, bh;
  canvas.getTextBounds(tag, 0, 0, &bx, &by, &bw, &bh);
  // Truncate on glyph boundaries, never rescale the font or wrap into the grid.
  size_t len = strlen(tag);
  while (bw > textW && len) {
    tag[--len] = '\0';
    canvas.getTextBounds(tag, 0, 0, &bx, &by, &bw, &bh);
  }
  canvas.setCursor(textX + (textW-(int)bw)/2-bx,
                   boxY + (boxH-(int)bh)/2-by);
  canvas.print(tag);
  canvas.setFont(NULL);
  canvas.setTextSize(1);
  if (showBpm) {
    canvas.setTextColor(BLACK);
    canvas.setCursor(14, 2);
    canvas.print(bpm); canvas.print(" BPM");
  }
  canvas.setTextColor(WHITE);
  if ((uint32_t)(millis() - lastKickMs) < 60)
    canvas.fillRect(canvas.width() - 3, 2, 2, 2, C(60, 220, 90));
  // Peak DSP generation time in the current one-second statistics window.
  // Excludes I2S waiting and task yield; this is block-budget use, not total CPU.
  float load = (float)genMaxUs / (1000000.0f * BLOCK / SR);
  uint16_t loadColor = load < 0.70f ? C(60, 220, 90) :
                       load < 0.90f ? C(255, 220, 60) : C(220, 60, 60);
  canvas.drawRect(canvas.width() - 14, 2, 10, 4, WHITE);
  canvas.fillRect(canvas.width() - 13, 3,
                  (int)(8 * constrain(load, 0.0f, 1.0f)), 2, loadColor);

  // Icon and phase strip retain their original positions and sizes.
  char modeIcon = 'E';
  uint16_t modeAccent = C(80, 220, 255);
  switch (mode) {
    case MODE_MUTE: modeIcon = 'M'; modeAccent = C(40,150,255); break;
    case MODE_MIX: modeIcon = 'X'; modeAccent = C(0,170,170); break;
    case MODE_NUDGE: modeIcon = 'U'; modeAccent = C(0,170,170); break;
    case MODE_DUCK: modeIcon = 'Y'; modeAccent = C(0,170,170); break;
    case MODE_PRESET: modeIcon = 'P'; modeAccent = C(140,40,200); break;
    case MODE_SOUND: modeIcon = 'S'; modeAccent = C(40,120,220); break;
    case MODE_KIT: modeIcon = 'K'; modeAccent = C(40,120,220); break;
    case MODE_NOTE: modeIcon = 'N'; modeAccent = C(140,40,200); break;
    case MODE_FX: modeIcon = 'F'; modeAccent = C(0,170,170); break;
    case MODE_GLITCH: modeIcon = 'G'; modeAccent = C(0,170,170); break;
    case MODE_LED: modeIcon = 'L'; modeAccent = C(190,130,240); break;
    case MODE_BRIGHT: modeIcon = 'B'; modeAccent = C(190,130,240); break;
    case MODE_BANK: modeIcon = 'A'; modeAccent = C(40,120,220); break;
    case MODE_BANK_SONG: modeIcon = 'O'; break;
    case MODE_CHAIN: modeIcon = 'c'; modeAccent = C(180,100,255); break;
    case MODE_SONG: modeIcon = 's'; modeAccent = C(180,100,255); break;
    case MODE_CHANCE: modeIcon = 'C'; modeAccent = C(60,220,90); break;
    case MODE_TEMPO: modeIcon = 'T'; modeAccent = C(40,150,255); break;
    case MODE_SWING: modeIcon = 'W'; break;
    case MODE_GLIDE: modeIcon = 'D'; break;
    case MODE_TRANSPOSE: modeIcon = 'H'; break;
    case MODE_COMP: modeIcon = 'Z'; modeAccent = C(0,170,170); break;
    case MODE_CHOKE: modeIcon = 'h'; modeAccent = C(180,100,255); break;
    case MODE_HUMAN: modeIcon = 'u'; modeAccent = C(180,100,255); break;
    case MODE_METRO: modeIcon = 'm'; modeAccent = C(180,100,255); break;
    case MODE_DENSITY: modeIcon = '%'; modeAccent = C(180,100,255); break;
    default: break;
  }
  if (mode == MODE_VOICE) modeIcon = 'V';
  if (mode == MODE_REC) modeIcon = 'R';
  if (mode == MODE_DENSITY) modeIcon = 'D';
  if (modeIcon >= 'a' && modeIcon <= 'z') modeIcon -= ('a' - 'A');
  if (secondaryTier && modeIcon >= 'A' && modeIcon <= 'Z') modeIcon += ('a' - 'A');
  canvas.fillRect(2, 1, 8, 8, modeAccent);
  canvas.setTextColor(BLACK);
  canvas.setTextSize(1);
  canvas.setCursor(3, 1);
  canvas.print(modeIcon);
  canvas.fillRect(0, 0, 160, 1, BLACK);
  float phase = constrain((float)sampleAccum / (float)curStepDur, 0.0f, 1.0f);
  if ((uint32_t)(millis() - lastKickMs) < 60)
    canvas.fillRect(0, 0, 160, 1, WHITE);
  else
    canvas.fillRect(0, 0, (int)(160 * phase), 1, C(180, 100, 255));

  // Playing-step comet: dim previous step first, bright current step on top.
  int prevStep = (currentStep + STEPS - 1) % STEPS;
  canvas.fillRect(startX + prevStep * colW - 1, 16, cellW + 2, 57, C(50,20,70));
  canvas.fillRect(startX + currentStep * colW - 1, 16, cellW + 2, 57, C(180,100,255));
  for (int stepIdx = 0; stepIdx <= 4; stepIdx += 4) {
    int x = startX + stepIdx * colW + cellW / 2;
    canvas.fillTriangle(x, 16, x - 2, 19, x + 2, 19, C(255, 220, 60));
  }
  float rowEnv[TRACKS] = {kickEnv, snareEnv, hatEnv, clapEnv, tomEnv, synthEnv[0], synthEnv[1]};

  for (int r = 0; r < TRACKS; r++) {
    if (trackNudge[r]) canvas.fillRect(startX-2,rowY[r],canvas.width()-startX+2,cellH,C(25,10,35));
    canvas.setTextColor(muted[r] ? GRAY : rowCol[r]);
    canvas.setCursor(4, rowY[r] - 1);
    canvas.print(rowLbl[r]);
    int meterH = constrain((int)(rowEnv[r] * cellH), 0, cellH);
    canvas.fillRect(11, rowY[r] + cellH - meterH, 2, meterH,
                    muted[r] ? C(40,40,40) : rowCol[r]);
    canvas.drawFastHLine(startX - 2, rowY[r] + cellH + 1,
                         canvas.width() - (startX - 2), C(10,10,15));
    for (int c = 0; c < STEPS; c++) {
      int x = startX + c * colW;
      int y = rowY[r];
      uint16_t cellCol = muted[r] ? C(55, 55, 55) : rowCol[r];
      if (pattern[r][c]) canvas.fillRect(x + 1, y + 1, cellW, cellH, C(0,0,30));
      if (pattern[r][c] == 2) {                 // accent — filled + a bright center marker
        canvas.fillRoundRect(x, y, cellW, cellH, 3, cellCol);
        if (reverseAccent[r]) canvas.fillTriangle(x+cellW/2,y+cellH-2,x+cellW/2-2,y+1,x+cellW/2+2,y+1,WHITE);
        else canvas.fillTriangle(x + cellW/2, y + 1,
                            x + cellW/2 - 2, y + cellH - 2,
                            x + cellW/2 + 2, y + cellH - 2, WHITE);
      } else if (pattern[r][c] == 1) {          // normal hit
        canvas.fillRoundRect(x, y, cellW, cellH, 3, cellCol);
      } else {                                  // empty
        canvas.drawRoundRect(x, y, cellW, cellH, 3, GRAY);
      }
      if (pattern[r][c] && c == currentStep && (uint32_t)(uiNow - stepTriggeredMs) < 40)
        canvas.drawRect(x - 1, y - 1, cellW + 2, cellH + 2, WHITE);
      if (ratchet[r][c] > 0) {
        // Compact 3x5 superscript digits: total hits 2, 3 or 4.
        const uint16_t digits[3] = {0x73e7, 0x73cf, 0x5bc9};
        uint16_t bits = digits[constrain((int)ratchet[r][c], 1, 3) - 1];
        canvas.fillRect(x + cellW - 4, y - 1, 4, 6, BLACK);
        for (int py = 0; py < 5; py++) for (int px = 0; px < 3; px++)
          if (bits & (1 << (14 - py * 3 - px))) canvas.drawPixel(x + cellW - 3 + px, y - 1 + py, WHITE);
      }
    }
    if (r == pasteRow && (uint32_t)(uiNow-pasteMs) < 150)
      canvas.drawRect(startX-1,rowY[r]-1,STEPS*colW,cellH+2,C(235,210,255));
    if (muted[r]) {
      canvas.drawFastHLine(2, rowY[r] + cellH / 2, startX + STEPS * colW - 2, C(220, 60, 60));
    }
  }

  // Pair-of-steps separators, below the selection outline.
  for (int group = 2; group <= 6; group += 2)
    canvas.drawFastVLine(startX + colW * group - 1, 16, 57, C(30,30,30));

  // cursor / selection
  int cr = cursor / STEPS, cc = cursor % STEPS;
  if (mode == MODE_MUTE) {
    // whole-row highlight for mute selection
    canvas.drawRoundRect(startX - 2, rowY[muteSel] - 2, STEPS * colW, cellH + 4, 4, C(40, 150, 255));
  } else if (mode == MODE_SOUND || mode == MODE_FX || mode == MODE_MIX || mode == MODE_HUMAN || mode == MODE_NUDGE || mode == MODE_VOICE || mode == MODE_REC) {
    // whole-row highlight — the track whose sound / effect is being edited
    canvas.drawRoundRect(startX - 2, rowY[cr] - 2, STEPS * colW, cellH + 4, 4, C(40, 120, 220));
  } else if (mode == MODE_NOTE) {
    // highlight the synth step being tuned, on the selected synth (B1/B2) row
    int cx = startX + noteStep * colW, cy = rowY[5 + noteSynth];
    canvas.drawRoundRect(cx - 1, cy - 1, cellW + 2, cellH + 2, 4, C(190, 130, 240));
  } else {
    int cx = startX + cc * colW, cy = rowY[cr];
    canvas.drawRoundRect(cx - 1, cy - 1, cellW + 2, cellH + 2, 4, WHITE);
  }

  if (mode == MODE_SONG) {
    // Arrangement view overlays only the grid; header/footer dimensions stay intact.
    canvas.fillRect(0, 16, 160, 57, BLACK);
    canvas.setTextColor(C(180,100,255));
    canvas.setCursor(2, 18);
    canvas.print(presetSongPlay ? "SONG PLAY" : "SONG STOP");
    canvas.setCursor(2, 27);
    canvas.print(songRepeatEdit ? "ENC2: REPEATS" : "ENC2: PRESET");
    const Arrangement &a = arrangements[arrangementOwner];
    for (int i = 0; i < 16; ++i) {
      int x = i * 10;
      uint16_t col = i == songPosition && presetSongPlay ? WHITE : C(100,60,140);
      if (a.song[i].preset) canvas.fillRect(x + 1, 42, 8, 10, col);
      else canvas.drawRect(x + 1, 42, 8, 10, GRAY);
      if (i == songEdit) canvas.drawFastHLine(x, 55, 10, C(180,100,255));
    }
    canvas.setCursor(2, 62);
    canvas.printf("S%02d P%03d x%d", songEdit + 1, a.song[songEdit].preset,
                  a.song[songEdit].repeats);
  }
  // Compact footer: marquee starts at 73; scope overlays y=76..79.
  canvas.fillRect(0, 73, canvas.width(), 7, BLACK);
  const char *presetName = (lastPreset >= 0 && lastPreset < presetCount) ? presets[lastPreset].name : "CUSTOM";
  canvas.setTextSize(1);
  canvas.setTextColor(C(100,60,140));
  canvas.setCursor(presetMarqueeX, 73);
  canvas.print(presetName);
  if (--presetMarqueeX < -(int)strlen(presetName) * 6) presetMarqueeX = canvas.width();
  uint8_t head = scopeHead;
  int prevX = 0, prevY = 78;
  for (int i = 0; i < 32; i++) {
    float value = scopeBuf[(head + i) % 32] / 32768.0f;
    int x = i * (canvas.width() - 1) / 31;
    int y = constrain((int)roundf(77.5f - value * 1.5f), 76, 79);
    if (i) canvas.drawLine(prevX, prevY, x, y, C(180,100,255));
    prevX = x; prevY = y;
  }

  // jam scale overlay — shown 2 seconds after both buttons cycle the scale
  if (jamScaleShowMs > 0 && millis() - jamScaleShowMs < 2000) {
    char tag[20];
    int len = snprintf(tag, sizeof(tag), "SCALE:%s", jamScaleNames[jamScaleIdx]);
    int tw = len * 6 + 4;
    int tx = (160 - tw) / 2;
    canvas.fillRect(tx - 2, 33, tw + 4, 13, C(80, 200, 255));
    canvas.setTextColor(C(0, 0, 0));
    canvas.setCursor(tx, 36);
    canvas.print(tag);
  }
  if (fillActive) {
    canvas.setTextColor(C(180,100,255)); canvas.setCursor(canvas.width()-20,10); canvas.print("FILL");
  }
  if (morphActive) canvas.fillRect(0,71,(int)(canvas.width()*morphAmt),1,C(180,100,255));
  if (mode == MODE_REC) {
    canvas.fillRect(2,1,8,8,BLACK); canvas.setTextColor(C(255,0,0));
    canvas.setCursor(3,1); canvas.print('R');
  }
  drawMenuHelp();
  tft.drawRGBBitmap(0, 0, canvas.getBuffer(), 160, 80);
}

// onboard button (GPIO45) — debounced edge detector (verbatim from the board notes)
bool onboardButtonPressed() {
  static bool state = HIGH, lastRaw = HIGH; static unsigned long tChange = 0;
  bool raw = digitalRead(45);
  if (raw != lastRaw) { lastRaw = raw; tChange = millis(); }
  if (millis() - tChange >= 40 && raw != state) { state = raw; if (state == LOW) return true; }
  return false;
}

// ---- Persistence (NVS) — the full editable state survives a power cycle.
void saveState() {
  prefs.begin("drum2", false);
  saveArrangements();
  savePerformanceState();
  prefs.putBytes("masterVerb", &masterVerbAmt, sizeof(masterVerbAmt));
  prefs.putBytes("glitchDepth", &glitchDepth, sizeof(glitchDepth));
  prefs.putInt("hatChoke", chokeHatOnClosed ? 1 : 0);
  prefs.putInt("metro", metronome ? 1 : 0);
  prefs.putBytes("pat", pattern, sizeof(pattern));
  prefs.putBytes("human", humanize, sizeof(humanize));
  prefs.putBytes("density", &densityScale, sizeof(densityScale));
  prefs.putBytes("ratchet", ratchet, sizeof(ratchet));
  prefs.putBytes("snd", soundVariant, sizeof(soundVariant));
  prefs.putBytes("fx", trackFX, sizeof(trackFX));
  prefs.putBytes("rvsend", reverbSend, sizeof(reverbSend));
  prefs.putBytes("note", synthNote, sizeof(synthNote));
  prefs.putBytes("mute", muted, sizeof(muted));
  prefs.putBytes("micro", stepMicro, sizeof(stepMicro));
  prefs.putBytes("duck", &sidechainDepth, sizeof(sidechainDepth));
  prefs.putBytes("gain", gTrack, sizeof(gTrack));
  prefs.putInt("bpm", bpm);
  prefs.putInt("swing", swing);
  prefs.putInt("vol", volume);
  prefs.putInt("bri", matBright);
  prefs.putInt("gfx", globalFX);
  prefs.putBytes("chance", chance, sizeof(chance));
  prefs.putBytes("bpat", bankPat, sizeof(bankPat));
  prefs.putBytes("bnote", bankNote, sizeof(bankNote));
  prefs.putBytes("scenes1", bankScene, sizeof(bankScene));
  prefs.putBytes("comp", &compThr, sizeof(compThr));
  prefs.putInt("cbank", curBank);
  prefs.putInt("led", ledStyle);
  prefs.putInt("glide", glideAmt);
  prefs.putInt("trans", transposeAmt);
  prefs.putInt("lpre", lastPreset);
  prefs.putInt("jscale", jamScaleIdx);
  prefs.end();
  Serial.println("state saved to flash");
}

void loadState() {
  prefs.begin("drum2", true);
  loadPerformanceState();
  // New keys preserve the existing namespace and all older records.
  // Missing or invalid values retain the original startup defaults.
  masterVerbAmt = 1.0f;
  glitchDepth = 1.0f;
  if (prefs.getBytesLength("masterVerb") == sizeof(masterVerbAmt))
    prefs.getBytes("masterVerb", &masterVerbAmt, sizeof(masterVerbAmt));
  if (prefs.getBytesLength("glitchDepth") == sizeof(glitchDepth))
    prefs.getBytes("glitchDepth", &glitchDepth, sizeof(glitchDepth));
  if (!isfinite(masterVerbAmt) || masterVerbAmt < 0 || masterVerbAmt > 2) masterVerbAmt = 1.0f;
  if (!isfinite(glitchDepth) || glitchDepth < 0 || glitchDepth > 1) glitchDepth = 1.0f;
  int savedChoke = prefs.getInt("hatChoke", 1);
  int savedMetro = prefs.getInt("metro", 0);
  chokeHatOnClosed = savedChoke == 0 ? false : true;
  metronome = savedMetro == 1;
  if (prefs.getBytesLength("human") == sizeof(humanize)) prefs.getBytes("human", humanize, sizeof(humanize));
  if (prefs.getBytesLength("density") == sizeof(densityScale)) prefs.getBytes("density", &densityScale, sizeof(densityScale));
  if (prefs.getBytesLength("ratchet") == sizeof(ratchet)) prefs.getBytes("ratchet", ratchet, sizeof(ratchet));
  if (!isfinite(densityScale) || densityScale < 0 || densityScale > 1) densityScale = 1;
  for (int tr = 0; tr < TRACKS; tr++) {
    humanize[tr] = constrain((int)humanize[tr], 0, 9);
    for (int st = 0; st < STEPS; st++) ratchet[tr][st] = constrain((int)ratchet[tr][st], 0, 3);
  }
  if (prefs.isKey("pat")) {
    prefs.getBytes("pat", pattern, sizeof(pattern));
    prefs.getBytes("snd", soundVariant, sizeof(soundVariant));
    prefs.getBytes("fx", trackFX, sizeof(trackFX));
    if (prefs.getBytesLength("rvsend") == sizeof(reverbSend))
      prefs.getBytes("rvsend", reverbSend, sizeof(reverbSend));
    for (int r = 0; r < TRACKS; r++)
      if (!isfinite(reverbSend[r]) || reverbSend[r] < 0 || reverbSend[r] > 1) reverbSend[r] = 1;
    prefs.getBytes("note", synthNote, sizeof(synthNote));
    prefs.getBytes("mute", muted, sizeof(muted));
    if (prefs.isKey("micro")) prefs.getBytes("micro", stepMicro, sizeof(stepMicro));
    if (prefs.isKey("duck")) prefs.getBytes("duck", &sidechainDepth, sizeof(sidechainDepth));
    if (prefs.isKey("gain")) prefs.getBytes("gain", gTrack, sizeof(gTrack));
    for (int st = 0; st < STEPS; st++)
      if (stepMicro[st] < -9 || stepMicro[st] > 9) stepMicro[st] = 0;
    if (!isfinite(sidechainDepth) || sidechainDepth < 0 || sidechainDepth > 1) sidechainDepth = 0.5f;
    const float defaults[TRACKS] = {0.55f, 0.32f, 0.20f, 0.26f, 0.30f, 0.34f, 0.34f};
    for (int tr = 0; tr < TRACKS; tr++)
      if (!isfinite(gTrack[tr]) || gTrack[tr] < 0 || gTrack[tr] > 2) gTrack[tr] = defaults[tr];
    bpm = prefs.getInt("bpm", bpm);
    swing = prefs.getInt("swing", swing);
    volume = prefs.getInt("vol", volume);
    matBright = prefs.getInt("bri", matBright);
    globalFX = prefs.getInt("gfx", globalFX);
    if (prefs.isKey("chance")) prefs.getBytes("chance", chance, sizeof(chance));
    prefs.getBytes("bpat", bankPat, sizeof(bankPat));
    prefs.getBytes("bnote", bankNote, sizeof(bankNote));
    curBank = prefs.getInt("cbank", 0);
    ledStyle    = prefs.getInt("led", ledStyle);
    glideAmt     = prefs.getInt("glide", 0);
    transposeAmt = prefs.getInt("trans", 0);
    lastPreset   = prefs.getInt("lpre", -1);
    jamScaleIdx  = prefs.getInt("jscale", 0);
    Serial.println("restored saved state from flash");
  }
  // Validate external saved values before any UI/DSP lookup or bank migration.
  // Valid saves are unchanged; invalid indices fall back to safe defaults.
  for (int tr = 0; tr < TRACKS; ++tr) {
    if (soundVariant[tr] < 0 || soundVariant[tr] >= variantCount[tr]) soundVariant[tr] = 0;
    if (trackFX[tr] < 0 || trackFX[tr] >= FXCOUNT) trackFX[tr] = 0;
    for (int st = 0; st < STEPS; ++st) {
      if (pattern[tr][st] > 2) pattern[tr][st] = 0;
      if (chance[tr][st] > 100) chance[tr][st] = 100;
      for (int b = 0; b < BANKS; ++b)
        if (bankPat[b][tr][st] > 2) bankPat[b][tr][st] = 0;
    }
  }
  // Expanded melodies intentionally include notes above the +/-24 editor range.
  // +/-48 admits all shipped melodies without permitting corrupt huge pitches.
  for (int sy = 0; sy < 2; ++sy) for (int st = 0; st < STEPS; ++st) {
    if (synthNote[sy][st] < -48 || synthNote[sy][st] > 48) synthNote[sy][st] = 0;
    for (int b = 0; b < BANKS; ++b)
      if (bankNote[b][sy][st] < -48 || bankNote[b][sy][st] > 48) bankNote[b][sy][st] = 0;
  }
  if (lastPreset < -1 || lastPreset >= presetCount) lastPreset = -1;
  if (jamScaleIdx < 0 || jamScaleIdx >= 8) jamScaleIdx = 0;
  if (globalFX < 0 || globalFX >= GFXCOUNT) globalFX = 0;
  if (ledStyle < 0 || ledStyle >= LEDCOUNT) ledStyle = 0;
  swing = constrain(swing, 0, 9);
  volume = constrain(volume, 0, 10);
  matBright = constrain(matBright, 0, 60);
  glideAmt = constrain(glideAmt, 0, 9);
  transposeAmt = constrain(transposeAmt, -24, 24);
  // Old pattern-only banks inherit current settings on first migration.
  for (int b = 0; b < BANKS; b++) captureBankScene(b);
  if (prefs.getBytesLength("scenes1") == sizeof(bankScene))
    prefs.getBytes("scenes1", bankScene, sizeof(bankScene));
  if (prefs.getBytesLength("comp") == sizeof(compThr))
    prefs.getBytes("comp", &compThr, sizeof(compThr));
  if (!isfinite(compThr) || compThr < 0.2f || compThr > 0.9f) compThr = 0.5f;
  curBank = constrain(curBank, 0, BANKS - 1);
  for (int b = 0; b < BANKS; b++) {
    BankScene &s = bankScene[b];
    bool valid = s.swing >= 0 && s.swing <= 9 && s.transpose >= -24 && s.transpose <= 24 &&
                 s.glide >= 0 && s.glide <= 9 && s.globalFX >= 0 && s.globalFX < GFXCOUNT &&
                 isfinite(s.verb) && s.verb >= 0 && s.verb <= 2 &&
                 isfinite(s.glitch) && s.glitch >= 0 && s.glitch <= 1 &&
                 isfinite(s.duck) && s.duck >= 0 && s.duck <= 1;
    for (int tr = 0; tr < TRACKS; tr++)
      valid = valid && s.fx[tr] >= 0 && s.fx[tr] < FXCOUNT &&
              s.sound[tr] >= 0 && s.sound[tr] < variantCount[tr] &&
              isfinite(s.gain[tr]) && s.gain[tr] >= 0 && s.gain[tr] <= 2;
    if (!valid) captureBankScene(b);
  }
  loadArrangements();
  prefs.end();
  setBPM(bpm);
}

// Directly trigger one synth voice (sy=0→B1, sy=1→B2) at a given semitone offset.
// Called from loop() by the jam buttons, independent of the sequencer pattern.
void triggerJamSynth(int sy, int8_t semitone) {
  int tr = 5 + sy;
  const SynthDef& sd = synthDefs[soundVariant[tr]];
  bool wasIdle = (synthEnv[sy] < 1e-4f);
  synthEnv[sy] = 1.0f; synthWave[sy] = sd.wave;
  synF[sy]     = sd.freq * powf(2.0f, (semitone + transposeAmt) / 12.0f);
  if (wasIdle || glideAmt == 0) synSlideF[sy] = synF[sy];
  synD[sy]     = decayC(sd.decay); synLPc[sy] = sd.lp;
  synthFEnv[sy] = 1.0f; synthFD[sy] = decayC(sd.decay * 0.6f);
  float fn = sd.freq / 220.0f; if (fn > 1.0f) fn = 1.0f;
  synDet[sy] = 1.003f + (sd.wave == 0 ? 0.007f : 0.003f) + sd.lp * 0.004f;
  synSubL[sy] = 0.15f + 0.45f * (1.0f - fn);
  synDrv[sy]  = 1.0f + (0.5f - sd.lp) * 1.6f;
  if (synDrv[sy] < 0.6f) synDrv[sy] = 0.6f; if (synDrv[sy] > 2.2f) synDrv[sy] = 2.2f;
  synRes[sy]  = 0.30f + sd.lp * 0.45f;
  synPEnv[sy] = (sd.decay < 0.15f) ? 0.5f : 0.15f; synPD[sy] = decayC(0.02f);
  synFmIdx[sy] = 0; synFmEnv[sy] = 0;
  synLfoInc[sy] = 0.0f; synLfoCut[sy] = 0.08f; synLfoPit[sy] = 0.0f; synFold[sy] = 0.0f;
  finishVoiceTrigger(tr, -1);
}

// Two Pad jam handler — called every loop() iteration.
// Button 1: fires synth B1 at the current minor-pentatonic note and steps UP the scale.
// Button 2: fires synth B2 a perfect 5th above its position and steps DOWN (counter-melody).
void handleJamButtons() {
  unsigned long now = millis();
  bool b1 = digitalRead(PAD_BTN1);
  bool b2 = digitalRead(PAD_BTN2);
  // Both-down edge toggles breakdown; a continuous hold also cycles scale once.
  static bool breakdownState = false;
  static bool scaleHoldHandled = false;
  static unsigned long bothDownMs = 0;
  if (b1 == LOW && b2 == LOW) {
    if (!jamBothLast) {
      breakdownState = !breakdownState;
      for (int tr = 0; tr < 5; tr++) muted[tr] = breakdownState;
      markDirty();
      Serial.printf("BREAKDOWN %s\n", breakdownState ? "ON" : "OFF");
      bothDownMs = now;
      scaleHoldHandled = false;
      jamBothLast = true;
    }
    if (!scaleHoldHandled && now - bothDownMs > 1000) {
      jamScaleIdx = (jamScaleIdx + 1) % 8;
      jamScaleShowMs = now;
      scaleHoldHandled = true;
      markDirty();
      Serial.printf("SCALE %s\n", jamScaleNames[jamScaleIdx]);
    }
    jamBtn1Last = LOW; jamBtn2Last = LOW;  // consume the event
    return;
  }
  jamBothLast = false;
  // 16th-note retrigger interval — hold either pad and it fires in tempo-sync
  unsigned long retrigMs = (unsigned long)(60000 / bpm / 4);
  if (retrigMs < 40) retrigMs = 40;
  if (b1 == LOW && jamBtn1Last == HIGH && now - jamBtn1Time > JAM_DEBOUNCE) {
    jamBtn1Time = now; jamBtn1PressMs = now; jamBtn1RetrigMs = now;
    triggerJamSynth(0, jamScales[jamScaleIdx][jamIdx1]);
    jamIdx1 = (jamIdx1 + 1) % 8;
  } else if (b1 == LOW && now - jamBtn1PressMs > 260 && now - jamBtn1RetrigMs > retrigMs) {
    jamBtn1RetrigMs = now;          // held: retrigger steps the scale at 16th-note rate
    triggerJamSynth(0, jamScales[jamScaleIdx][jamIdx1]);
    jamIdx1 = (jamIdx1 + 1) % 8;
  }
  jamBtn1Last = b1;
  if (b2 == LOW && jamBtn2Last == HIGH && now - jamBtn2Time > JAM_DEBOUNCE) {
    jamBtn2Time = now; jamBtn2PressMs = now; jamBtn2RetrigMs = now;
    triggerJamSynth(1, jamScales[jamScaleIdx][jamIdx2] + 7);
    jamIdx2 = (jamIdx2 - 1 + 8) % 8;
  } else if (b2 == LOW && now - jamBtn2PressMs > 260 && now - jamBtn2RetrigMs > retrigMs) {
    jamBtn2RetrigMs = now;
    triggerJamSynth(1, jamScales[jamScaleIdx][jamIdx2] + 7);
    jamIdx2 = (jamIdx2 - 1 + 8) % 8;
  }
  jamBtn2Last = b2;
}

void setup() {
  Serial.setTxTimeoutMs(0);
  Serial.begin(115200);
  delay(500);
  Serial.println("BOOT:1"); Serial.flush();
  for (int i = 0; i <= SIN_TBL; i++) sinTbl[i] = sinf(TWO_PI_F * i / SIN_TBL);
  for (int i = 0; i <= 1024; ++i) {
    float x = i * (3.0f / 1024.0f), x2 = x*x;
    saturationTable[i] = x*(27.0f+x2)/(27.0f+9.0f*x2);
  }
  d003=decayC(0.003f); d0025=decayC(0.0025f);
  d004=decayC(0.004f); d055=decayC(0.055f);
  d22=decayC(0.22f); d0012=decayC(0.0012f);
  d070=decayC(0.070f); d014=decayC(0.014f);
  Serial.println("DSP LUT1: saturation lookup, startup envelope coefficients");
  Serial.println("BOOT:2"); Serial.flush();
  pinMode(ENC_BTN, INPUT);           // encoder button: active HIGH, built-in pull-down — do NOT use INPUT_PULLUP
  pinMode(45, INPUT_PULLUP);
  Serial.println("BOOT:3"); Serial.flush();
  Serial.println("BOOT:4"); Serial.flush();
  loadState();

  {  // seed bank A with the live pattern if no bank holds anything yet
    bool any = false;
    for (int i = 0; i < BANKS; i++) if (bankHasHits(i)) any = true;
    if (!any) { memcpy(bankPat[0], pattern, sizeof(pattern)); for (int c = 0; c < STEPS; c++) { bankNote[0][0][c] = synthNote[0][c]; bankNote[0][1][c] = synthNote[1][c]; } }
  }

  // Touchpad TTP223 on P3 — INPUT (has onboard driver, NOT INPUT_PULLUP)
  pinMode(TOUCH_PIN, INPUT);
  pinMode(DRUM_BUTTON, INPUT);  // AX22-0050 built-in pull-up and RC filter
  pinMode(DRUM_LED, OUTPUT);
  digitalWrite(DRUM_LED, LOW);
  // Two Pad on P7 — INPUT_PULLUP, LOW when pressed
  pinMode(PAD_BTN1, INPUT_PULLUP);
  pinMode(PAD_BTN2, INPUT_PULLUP);
  // Encoder 2 on P5 — normal GPIO, no UART0 special handling needed.
  pinMode(ENC2_CLK, INPUT_PULLUP);
  pinMode(ENC2_DT,  INPUT_PULLUP);
  pinMode(ENC2_BTN, INPUT);           // encoder 2 button: active HIGH, built-in pull-down — do NOT use INPUT_PULLUP
  // Amp on P8 — P8_IO1/IO2 are UART0 pins but i2s_set_pin() reconfigures them
  // via the GPIO matrix automatically; no explicit pinMode() needed here.

  onboardPixel.begin();
  onboardPixel.setPixelColor(0, 0);  // off
  onboardPixel.show();

  // Encoder 1 on P1 — explicit pullups (library also sets these, but explicit is safer)
  pinMode(ENC_CLK, INPUT_PULLUP);
  pinMode(ENC_DT,  INPUT_PULLUP);

  Serial.println("SPI init...");
  mySPI.begin(SCK, MISO, MOSI);
  delay(300);                  // give the display time to wake after SPI init
  Serial.println("TFT init..."); Serial.flush();
  tft.initR(INITR_MINI160x80);
  tft.setRotation(3);
  Serial.printf("TFT W=%d H=%d\n", tft.width(), tft.height()); Serial.flush();
  tft.fillScreen(0);
  uint16_t uv = tft.color565(180, 100, 255);
  tft.setTextSize(2);
  tft.setTextColor(uv);
  const char* txt = "brikOS DRUMS";
  const int len = (int)strlen(txt);   // length-driven: renaming the splash can't overflow buf
  int fullW = len * 12;               // textSize 2 → 12 px per glyph (144 px of 160 here)
  int xStart = (160 - fullW) / 2;
  int y = 32;
  for (int n = 1; n <= len; n++) {
    char buf[32] = {0};
    strncpy(buf, txt, n);
    tft.setCursor(xStart, y);
    tft.print(buf);
    delay(60);
  }
  for (int b = 0; b < 10; b++) {
    float t = b / 9.0f;
    uint8_t r = (uint8_t)(180 * (0.6f + 0.4f * cosf(t * TWO_PI)));
    uint8_t g = (uint8_t)(100 * (0.6f + 0.4f * cosf(t * TWO_PI)));
    uint8_t bl = (uint8_t)(255 * (0.6f + 0.4f * cosf(t * TWO_PI)));
    tft.setCursor(xStart, y);
    tft.setTextColor(tft.color565(r, g, bl));
    tft.print(txt);
    delay(55);
  }
  tft.fillScreen(0);
  Serial.println("TFT ok"); Serial.flush();

  // Read initial hardware state
  {
    int raw = analogRead(POT_PIN);
    volume = raw * 10 / 4095;
    Serial.printf("Pot raw=%d volume=%d\n", raw, volume);
  }
  Serial.println("Boot: always playing. P3=kick, P4=snare.");

  lastEncPos  = encoder.getPosition();
  lastEncPos2  = encoder2.getPosition();
  // Sync button init state to ACTUAL pin reading so the first call never generates a fake edge
  lastBtnState = digitalRead(ENC_BTN);
  curStepDur = stepDuration(currentStep);
  nextStepDuration = stepDuration((currentStep + 1) % STEPS);
  triggerStep();  // fire step 0 and initialize its ratchet schedule
  planNudges(true);

  // dedicated audio producer on core 0 — Arduino loop() (display + matrix)
  // runs on core 1, so audio gets a core to itself and never stalls on SPI.
  // Generation takes ~1ms of the ~2.9ms block budget, so i2s_write blocks the
  // rest of each block waiting on DMA and the core-0 idle task runs normally to
  // feed the watchdog. (Do NOT disableCore0WDT here — once the task blocks like
  // this, the unsubscribed idle task floods the log with 'task not found'.)
  xTaskCreatePinnedToCore(audioTask, "audio", 16384, NULL, 2, NULL, 0);
  Serial.println("Ready. Boots in EDIT; long-press cycles MUTE/VOLUME/PRESET/SOUND/KIT/NOTE/FX/GLITCH/LED/BRIGHT/BANK/SONG/CHANCE/TEMPO/SWING/GLIDE/TRANSPOSE; always playing; P3 kick, P4 snare; tap in TEMPO = tap tempo.");
}

void loop() {
  encoder.tick();
  encoder2.tick();
  handleButton();
  updateRecordMode();
  handleEncoder();
  handlePot();
  handleDrumButton();
  handleTouchpad();
  handleEncoder2();

  if (onboardButtonPressed()) {          // onboard button = quick next preset
    presetSel = (presetSel + 1) % presetCount;
    loadPreset(presetSel);
    markDirty();
  }

  if (wrapAdvance) {
    wrapAdvance = false;
    if (!advancePresetArrangement() && songMode) {
      saveBankFromLive();
      int nb = curBank;
      for (int i = 0; i < BANKS; i++) { nb = (nb + 1) % BANKS; if (bankHasHits(nb)) break; }
      loadBankToLive(nb);
    }
  }

  if (stateDirty && millis() - lastChangeMs > 2500) {  // debounced auto-save to flash
    saveState();
    stateDirty = false;
  }

  handleJamButtons();          // Two Pad (P3): Button1 = play B1 up scale, Button2 = play B2 down (5th)
  unsigned long now = millis();
  if (now - lastDraw >= 50) { drawUI(); lastDraw = now; }
  delay(1);  // yield the UI core between control polls

  if (now - lastStat >= 1000) {
    uint32_t blk = genBlocks;
    if (blk) {
      float avg = (float)genSumUs / blk;
      float budget = 1000000.0f * BLOCK / SR;
      Serial.printf("audio LUT1: %lu blk/s (need %d), gen avg %.0fus max %luus, budget %.0fus\n",
                    blk, SR / BLOCK, avg, genMaxUs, budget);
    }
    genMaxUs = 0; genSumUs = 0; genBlocks = 0; lastStat = now;
  }
}
