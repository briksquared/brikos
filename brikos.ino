void captureBankScene(int b) {
  BankScene &s = bankScene[b];
  memcpy(s.mute, muted, sizeof(muted));
  memcpy(s.fx, trackFX, sizeof(trackFX));
  memcpy(s.sound, soundVariant, sizeof(soundVariant));
  memcpy(s.gain, gTrack, sizeof(gTrack));
  s.swing = swing; s.transpose = transposeAmt; s.glide = glideAmt;
  s.globalFX = globalFX; s.verb = masterVerbAmt;
  s.glitch = glitchDepth; s.duck = sidechainDepth;
}
void copyLiveToBank(int b) {
  memcpy(bankPat[b], pattern, sizeof(pattern));
  memcpy(bankNote[b], synthNote, sizeof(synthNote));
  captureBankScene(b);
}
void saveBankFromLive() {
  copyLiveToBank(curBank);
}
void loadBankToLive(int b) {
  morphActive = morphTransient = false;
  memcpy(pattern, bankPat[b], sizeof(pattern));
  for (int c = 0; c < STEPS; c++) { synthNote[0][c] = bankNote[b][0][c]; synthNote[1][c] = bankNote[b][1][c]; }
  const BankScene &s = bankScene[b];
  memcpy(muted, s.mute, sizeof(muted));
  memcpy(trackFX, s.fx, sizeof(trackFX));
  memcpy(soundVariant, s.sound, sizeof(soundVariant));
  memcpy(gTrack, s.gain, sizeof(gTrack));
  swing = s.swing; transposeAmt = s.transpose; glideAmt = s.glide;
  globalFX = s.globalFX; masterVerbAmt = s.verb;
  glitchDepth = s.glitch; sidechainDepth = s.duck;
  curBank = b;
}
