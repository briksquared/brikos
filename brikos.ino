void loadPreset(int idx) {
  if (idx < 0 || idx >= presetCount) return;
  morphActive = morphTransient = false;
  if (!arrangementLoading) {
    stopPresetArrangement();
    arrangementOwner = idx;
  }
  // Original entries are expanded by name; appended entries carry explicit scenes.
  const Preset p = idx < 149 ? presetWithScene(presets[idx], presetSwing[idx]) : presets[idx];
  for (int r = 0; r < TRACKS; r++) {
    for (int c = 0; c < STEPS; c++) pattern[r][c] = p.pat[r][c];
    soundVariant[r] = p.snd[r];
    trackFX[r] = p.trackFX[r];
    reverbSend[r] = p.reverbSend[r] / 255.0f;
    gTrack[r] = p.gTrack[r] / 255.0f * 2.0f;
  }
  masterVerbAmt = p.masterVerbAmt;
  compThr = p.compThr / 255.0f;
  globalFX = p.globalFX;
  transposeAmt = p.transposeAmt;
  glideAmt = p.glideAmt;
  // Per-preset groove swing — the single biggest groove improvement: hip-hop presets
  // swing at 6, funk at 5, latin at 3-4, house/techno stay straight.
  swing = p.swing;
  loadKit(presetKit[idx]);     // override drums with genre-matched kit (leaves synth voices untouched)
  // Auto-accent for dynamics: kick beats 1 & 3 (steps 0 & 4) always punch hardest
  // since they're the downbeats; every snare hit accents because it IS the backbeat.
  // These two changes alone make any pattern sound produced rather than flat.
  if (pattern[0][0] >= 1) pattern[0][0] = 2;  // kick downbeat 1
  if (pattern[0][4] >= 1) pattern[0][4] = 2;  // kick downbeat 3
  for (int c = 0; c < STEPS; c++) {
    if (pattern[1][c] >= 1) pattern[1][c] = 2;  // all snare hits accent
  }
  if (idx >= duoStart && idx < duoStart + 16) {                       // two-synth preset: a real line on BOTH synths
    const int8_t* m1 = melTemplates[duoMel1[idx - duoStart]];
    const int8_t* m2 = melTemplates[duoMel2[idx - duoStart]];
    for (int c = 0; c < STEPS; c++) { synthNote[0][c] = m1[c]; synthNote[1][c] = m2[c]; }
  } else {
    // every preset now plays BOTH synths: synth 1 carries the bassline, synth 2
    // doubles it an octave up on a brighter voice for a two-part line.
    const int8_t* mel = melTemplates[presetMelIdx[idx]];
    for (int c = 0; c < STEPS; c++) {
      synthNote[0][c] = mel[c];
      synthNote[1][c] = mel[c] + 12;      // octave-up counter line
      if (idx < 149) pattern[6][c] = pattern[5][c]; // preserve explicit new B2 patterns
    }
    if (idx < 149) soundVariant[6] = (soundVariant[5] + 20) % 120; // legacy doubling only
  }
  muted[5] = true; muted[6] = true;   // synths muted on preset load; unmute in MUTE mode
  setBPM(p.bpm);
  lastPreset = idx;
  markDirty();
  Serial.printf("SCENE %d/%d: %s\n", idx + 1, presetCount, p.name);
}

// ---- Pattern-bank helpers: the live pattern[]/synthNote[] is the working copy;
